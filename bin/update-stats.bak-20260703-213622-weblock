@dataclass
class CmdResult:
    args: list[str]
    exit_code: int
    stdout: str
    stderr: str
    timeout_s: int


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def fetch_minimax_api_limits() -> dict[str, Any] | None:
    """
    Fetch real MiniMax rate limits from the API.
    Returns dict with usage info or None if fetch fails.
    """
    api_key = os.environ.get("MINIMAX_API_KEY", "sk-cp-okvPF0JbL7yuxX1JTpkdWMwYk5Zu3xiEBkaGH3O6uzDrcud8f7yyeZUAQEJhgbJOg26lGFbvrXxOaxAfiyKL0JO63Cd7xlfPdD6SsglNdhvN95Fi9D8RfMg")
    url = "https://www.minimax.io/v1/api/openplatform/coding_plan/remains"
    
    try:
        req = urllib.request.Request(
            url,
            headers={
                "Authorization": f"Bearer {api_key}",
                "User-Agent": "CodexBar-Stats/1.0",
            },
            method="GET"
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        
        # Check for API errors
        base_resp = data.get("base_resp", {})
        if base_resp.get("status_code") != 0:
            return None
        
        model_remains = data.get("model_remains", [])
        if not model_remains:
            return None
        
        # Use first (usually only) model entry
        model_data = model_remains[0]
        
        total_count = int(model_data.get("current_interval_total_count", 0) or 0)
        # Despite the field name, current_interval_usage_count from /coding_plan/remains
        # behaves as a remaining counter (starts at total and decreases with usage).
        api_remaining_count = int(model_data.get("current_interval_usage_count", 0) or 0)
        remains_time_seconds = model_data.get("remains_time", 0)
        start_time_ms = model_data.get("start_time", 0)
        end_time_ms = model_data.get("end_time", 0)
        model_name = model_data.get("model_name", "MiniMax-M2")
        
        # Calculate derived values
        remaining_count = max(0, min(total_count, api_remaining_count))
        usage_count = max(0, total_count - remaining_count)
        used_percent = round((usage_count / total_count) * 100) if total_count > 0 else 0
        
        # Calculate window duration (MiniMax uses 5-hour windows)
        window_duration_ms = end_time_ms - start_time_ms
        window_minutes = round(window_duration_ms / (60 * 1000)) if window_duration_ms > 0 else 300
        
        # Reset time is end_time
        resets_at_ms = end_time_ms
        resets_at = datetime.fromtimestamp(resets_at_ms / 1000, tz=timezone.utc).isoformat()
        
        # Calculate time until reset
        now_ms = datetime.now(timezone.utc).timestamp() * 1000
        time_until_reset_seconds = max(0, int((resets_at_ms - now_ms) / 1000))
        
        return {
            "model_name": model_name,
            "total_count": total_count,
            "usage_count": usage_count,
            "remaining_count": remaining_count,
            "used_percent": used_percent,
            "remains_time_seconds": time_until_reset_seconds,
            "resets_at": resets_at,
            "window_minutes": window_minutes,
            "start_time": datetime.fromtimestamp(start_time_ms / 1000, tz=timezone.utc).isoformat(),
            "end_time": datetime.fromtimestamp(end_time_ms / 1000, tz=timezone.utc).isoformat(),
        }
    except Exception:
        return None


def safe_tail(value: str, max_chars: int) -> str:
    value = value.strip()
    if len(value) <= max_chars:
        return value
    return value[-max_chars:]


def ensure_path_has_dir(env: dict[str, str], directory: str) -> dict[str, str]:
    directory = directory.strip()
    if not directory:
        return env

    current = env.get("PATH", "")
    parts = [p for p in current.split(os.pathsep) if p] if current else []
    if directory in parts:
        return env

    updated = dict(env)
    updated["PATH"] = os.pathsep.join([directory] + parts) if parts else directory
    return updated


def run_cmd(args: list[str], *, timeout_s: int, env: dict[str, str] | None = None) -> CmdResult:
    try:
        proc = subprocess.Popen(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            text=True,
            encoding="utf-8",
            errors="replace",
            start_new_session=True,
        )
    except FileNotFoundError as e:
        return CmdResult(args=args, exit_code=127, stdout="", stderr=str(e), timeout_s=timeout_s)

    try:
        stdout, stderr = proc.communicate(timeout=timeout_s)
        return CmdResult(args=args, exit_code=proc.returncode or 0, stdout=stdout, stderr=stderr, timeout_s=timeout_s)
    except subprocess.TimeoutExpired as e:
        stdout = (e.output or "") if isinstance(e.output, str) else ""
        stderr = (e.stderr or "") if isinstance(e.stderr, str) else ""

        # Kill the whole process group to avoid leaving orphaned children behind.
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

        try:
            more_stdout, more_stderr = proc.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            more_stdout, more_stderr = proc.communicate()

        if more_stdout:
            stdout = (stdout or "") + more_stdout
        if more_stderr:
            stderr = (stderr + "\n" if stderr else "") + more_stderr

        stderr = (stderr + "\n" if stderr else "") + f"Timeout after {timeout_s}s"
        return CmdResult(args=args, exit_code=124, stdout=stdout, stderr=stderr, timeout_s=timeout_s)
    except FileNotFoundError as e:
        return CmdResult(args=args, exit_code=127, stdout="", stderr=str(e), timeout_s=timeout_s)


def is_claude_oauth_token_expired(res: CmdResult) -> bool:
    haystack = f"{res.stdout}\n{res.stderr}".lower()
    return "claude oauth token expired" in haystack or "oauth token expired" in haystack


def resolve_claude_bin() -> str:
    """
    systemd timers often run with a minimal PATH that excludes ~/.local/bin.
    Prefer an explicit env override, then PATH lookup, then ~/.local/bin.
    """
    env_bin = os.environ.get("CLAUDE_BIN")
    if env_bin:
        return env_bin

    which_bin = shutil.which("claude")
    if which_bin:
        return which_bin

    local_bin = Path.home() / ".local" / "bin" / "claude"
    if local_bin.is_file():
        return str(local_bin)

    return "claude"


def refresh_claude_oauth_token(*, errors: list[dict[str, Any]], max_stderr_chars: int) -> None:
    """
    Best-effort auth refresh to keep CodexBar's Claude OAuth source working.

    CodexBar suggests: "Run `claude` to refresh." We do this via a tiny
    `claude -p ...` request, which *may spend Claude credits* (model call).
    """
    claude_bin = resolve_claude_bin()
    max_budget_usd = os.environ.get("CLAUDE_REFRESH_MAX_BUDGET_USD", "0.0001")
    timeout_s = int(os.environ.get("CLAUDE_REFRESH_TIMEOUT_S", "60"))

    model = os.environ.get("CLAUDE_REFRESH_MODEL", "sonnet").strip()
    no_session_persistence = os.environ.get("CLAUDE_REFRESH_NO_SESSION_PERSISTENCE", "1").strip().lower() in (
        "1",
        "true",
        "yes",
        "y",
        "on",
    )
    tools_value = os.environ.get("CLAUDE_REFRESH_TOOLS")
    # Default to disabling tools entirely to minimize prompt size/cost.
    if tools_value is None:
        tools_value = ""

    args = [claude_bin, "-p", "ping", "--output-format", "json", "--max-budget-usd", max_budget_usd]
    if model:
        args.extend(["--model", model])
    args.extend(["--tools", tools_value])
    if no_session_persistence:
        args.append("--no-session-persistence")

    res = run_cmd(
        args,
        timeout_s=timeout_s,
    )
    # Claude Code may exit 0 while reporting an auth error in JSON output.
    parsed = None
    last_line = ""
    for line in res.stdout.splitlines()[::-1]:
        if line.strip():
            last_line = line.strip()
            break
    if last_line:
        try:
            parsed = json.loads(last_line)
        except Exception:
            parsed = None

    parsed_is_error = isinstance(parsed, dict) and parsed.get("is_error") is True

    if res.exit_code != 0 or parsed_is_error:
        msg = safe_tail(res.stderr, max_stderr_chars).strip()
        if not msg and isinstance(parsed, dict) and isinstance(parsed.get("result"), str):
            msg = safe_tail(parsed["result"], max_stderr_chars).strip()
        if not msg:
            msg = safe_tail(res.stdout, max_stderr_chars).strip()

        lower = msg.lower()
        if "invalid api key" in lower or "please run /login" in lower:
            msg = f"{msg} (Fix: run `claude setup-token` (preferred) or open `claude` and run `/login` once as the service user.)"
        elif "oauth token" in lower or "authentication_error" in lower:
            msg = f"{msg} (Fix: run `claude setup-token` or open `claude` and re-auth.)"

        errors.append(
            {
                "command": "claude -p ping",
                "exitCode": res.exit_code,
                "message": msg or f"Exit {res.exit_code}",
            }
        )


def annotate_claude_usage_errors(items: list[Any]) -> None:
    """
    CodexBar Claude usage relies on the Claude OAuth token. When it's missing,
    CodexBar returns a generic "No available fetch strategy" error which isn't
    actionable in the dashboard. Add a short fix hint.
    """
    for item in items:
        if not isinstance(item, dict):
            continue
        if item.get("provider") != "claude":
            continue
        err = item.get("error")
        if not isinstance(err, dict):
            continue
        msg = str(err.get("message") or "").strip()
        if not msg:
            continue
        if "no available fetch strategy for claude" in msg.lower():
            err["message"] = (
                "No available fetch strategy for claude. "
                "Fix: run `claude setup-token` once on this machine as the same user that runs the stats updater."
            )


def has_claude_fetch_strategy_error(items: list[Any]) -> bool:
    for item in items:
        if not isinstance(item, dict):
            continue
        if item.get("provider") != "claude":
            continue
        err = item.get("error")
        if not isinstance(err, dict):
            continue
        msg = str(err.get("message") or "").lower()
        if "no available fetch strategy for claude" in msg:
            return True
    return False


def parse_json_arrays(stdout: str, *, errors: list[dict[str, Any]], context: str) -> list[Any]:
    items: list[Any] = []
    for line in stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            parsed = json.loads(line)
        except Exception as e:
            errors.append(
                {
                    "command": "json.parse",
                    "context": context,
                    "exitCode": 0,
                    "message": f"Failed to parse JSON line: {e}",
                }
            )
            continue
        if isinstance(parsed, list):
            items.extend(parsed)
        else:
            items.append(parsed)
    return items


def atomic_write_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, prefix=f".{path.name}.", delete=False) as f:
        tmp_path = Path(f.name)
        json.dump(payload, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.chmod(tmp_path, 0o644)
    os.replace(tmp_path, path)


def load_history(path: Path) -> list[dict[str, Any]]:
    if not path.is_file():
        return []
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
            return data if isinstance(data, list) else []
    except Exception:
        return []


def load_json(path: Path) -> Any | None:
    if not path.is_file():
        return None
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def prune_redundant_usage_snapshot_runs(history: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """
    Remove repeated full-session snapshot artifacts caused by missing prev-state.

    When delta state fails to load, usage-snapshot entries can be recorded every
    run with `activity == sessionPct` for the same provider/account/sessionPct.
    Keep the first sample in a flat run and drop the rest.
    """
    if not isinstance(history, list) or not history:
        return []

    def sort_key(entry: dict[str, Any]) -> tuple[str, str, str, str]:
        provider = str(entry.get("provider") or "")
        account = str(entry.get("account") or "")
        source = str(entry.get("source") or "")
        ts = str(entry.get("ts") or "")
        return (provider, account, source, ts)

    cleaned: list[dict[str, Any]] = []
    last_kept_key: tuple[str, str, str] | None = None
    last_kept_session_pct: float | None = None

    for entry in sorted(history, key=sort_key):
        if not isinstance(entry, dict):
            continue

        source = str(entry.get("source") or "").strip().lower()
        provider = str(entry.get("provider") or "").strip().lower()
        account = str(entry.get("account") or "")
        session_pct = as_finite_number(entry.get("sessionPct"))
        activity = as_finite_number(entry.get("activity"))

        if (
            source == "usage-snapshot"
            and provider
            and session_pct is not None
            and activity is not None
            and session_pct > 0
            and abs(activity - session_pct) < 0.001
        ):
            current_key = (provider, account, source)
            if last_kept_key == current_key and last_kept_session_pct is not None and abs(session_pct - last_kept_session_pct) < 0.001:
                continue
            last_kept_key = current_key
            last_kept_session_pct = session_pct
            cleaned.append(entry)
            continue

        if source == "usage-snapshot":
            last_kept_key = (provider, account, source)
            last_kept_session_pct = session_pct
        else:
            last_kept_key = None
            last_kept_session_pct = None
        cleaned.append(entry)

    cleaned.sort(key=lambda entry: str(entry.get("ts") or ""))
    return cleaned


def parse_iso_datetime(value: Any) -> datetime | None:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        if not isinstance(value, bool) and value > 0:
            # Heuristic: treat < 1e12 as seconds, otherwise ms.
            ts = float(value)
            if ts > 1e12:
                ts = ts / 1000.0
            try:
                return datetime.fromtimestamp(ts, tz=timezone.utc)
            except Exception:
                return None
        return None
    if isinstance(value, str):
        s = value.strip()
        if not s:
            return None
        try:
            if s.endswith("Z"):
                s = s[:-1] + "+00:00"
            dt = datetime.fromisoformat(s)
            if dt.tzinfo is None:
                return dt.replace(tzinfo=timezone.utc)
            return dt.astimezone(timezone.utc)
        except Exception:
            return None
    return None


def decode_jwt_payload(token: Any) -> dict[str, Any] | None:
    if not isinstance(token, str):
        return None
    token = token.strip()
    if not token:
        return None

    parts = token.split(".")
    if len(parts) < 2:
        return None

    payload = parts[1].strip()
    if not payload:
        return None

    padding = "=" * ((4 - (len(payload) % 4)) % 4)
    try:
        decoded = base64.urlsafe_b64decode(payload + padding)
    except Exception:
        return None

    try:
        parsed = json.loads(decoded.decode("utf-8", errors="replace"))
    except Exception:
        return None

    return parsed if isinstance(parsed, dict) else None


def codex_profile_identity_key(account_payload: Any) -> str | None:
    if not isinstance(account_payload, dict):
        return None

    tokens = account_payload.get("tokens")
    if not isinstance(tokens, dict):
        return None

    claims = decode_jwt_payload(tokens.get("id_token")) or decode_jwt_payload(tokens.get("access_token"))
    if not isinstance(claims, dict):
        return None

    sub = claims.get("sub")
    if isinstance(sub, str) and sub.strip():
        return f"sub:{sub.strip()}"

    email = claims.get("email")
    if isinstance(email, str) and email.strip():
        return f"email:{email.strip().lower()}"

    return None


def utc_iso_from_epoch_seconds(value: Any) -> str | None:
    if isinstance(value, bool):
        return None
    try:
        ts = float(value)
    except Exception:
        return None
    if not ts > 0:
        return None
    try:
        return datetime.fromtimestamp(ts, tz=timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    except Exception:
        return None


def normalize_utc_iso(value: Any) -> str | None:
    dt = parse_iso_datetime(value)
    if dt is None:
        return None
    return dt.replace(microsecond=0).isoformat().replace("+00:00", "Z")


def codex_profile_auth_meta(account_payload: Any, *, now: datetime) -> dict[str, Any] | None:
    if not isinstance(account_payload, dict):
        return None

    tokens = account_payload.get("tokens")
    if not isinstance(tokens, dict):
        return None

    claims = decode_jwt_payload(tokens.get("access_token"))
    exp = claims.get("exp") if isinstance(claims, dict) else None
    expires_at = utc_iso_from_epoch_seconds(exp)

    meta: dict[str, Any] = {}
    last_refresh = normalize_utc_iso(account_payload.get("last_refresh"))
    if last_refresh:
        meta["lastRefresh"] = last_refresh

    if expires_at:
        expires_dt = parse_iso_datetime(expires_at)
        meta["accessTokenExpiresAt"] = expires_at
        if expires_dt is not None:
            expires_in = int(round((expires_dt - now).total_seconds()))
            meta["expiresInSeconds"] = expires_in
            meta["expired"] = expires_in <= 0

    return meta or None


def short_identity_fingerprint(identity_key: str) -> str:
    key = str(identity_key or "")
    if not key:
        return "unknown"
    return hashlib.sha256(key.encode("utf-8")).hexdigest()[:10]


def parse_iso_datetime_lenient(value: Any) -> datetime | None:
    parsed = parse_iso_datetime(value)
    if parsed is not None:
        return parsed

    if not isinstance(value, str):
        return None

    # Antigravity writes RFC3339 timestamps with nanosecond precision; Python's
    # datetime parser only needs microseconds.
    match = re.match(r"^(.+?\.)(\d{6})\d+([+-]\d\d:\d\d|Z)$", value.strip())
    if not match:
        return None
    return parse_iso_datetime("".join(match.groups()))


def resolve_antigravity_bin() -> str:
    env_bin = os.environ.get("ANTIGRAVITY_BIN")
    if env_bin:
        return env_bin

    which_bin = shutil.which("agy")
    if which_bin:
        return which_bin

    for candidate in (Path("/usr/local/bin/agy"), Path.home() / ".local" / "bin" / "agy"):
        if candidate.is_file():
            return str(candidate)

    return "agy"


def load_antigravity_token_payload(token_path: Path) -> dict[str, Any]:
    payload = load_json(token_path)
    if not isinstance(payload, dict):
        return {}
    token = payload.get("token")
    if not isinstance(token, dict):
        return {}
    return {
        "accessToken": token.get("access_token") if isinstance(token.get("access_token"), str) else None,
        "refreshTokenPresent": bool(token.get("refresh_token")),
        "tokenType": token.get("token_type") if isinstance(token.get("token_type"), str) else None,
        "expiry": token.get("expiry") if isinstance(token.get("expiry"), str) else None,
        "authMethod": payload.get("auth_method") if isinstance(payload.get("auth_method"), str) else None,
    }


def antigravity_token_meta(token_payload: dict[str, Any], *, now: datetime) -> dict[str, Any]:
    meta: dict[str, Any] = {}
    expiry_dt = parse_iso_datetime_lenient(token_payload.get("expiry"))
    if expiry_dt is not None:
        expires_at = expiry_dt.replace(microsecond=0).isoformat().replace("+00:00", "Z")
        expires_in = int(round((expiry_dt - now).total_seconds()))
        meta["accessTokenExpiresAt"] = expires_at
        meta["expiresInSeconds"] = expires_in
        meta["expired"] = expires_in <= 0
    if token_payload.get("authMethod"):
        meta["authMethod"] = token_payload["authMethod"]
    return meta


def refresh_antigravity_token_if_needed(
    token_path: Path,
    *,
    now: datetime,
    base_env: dict[str, str],
    errors: list[dict[str, Any]],
    max_stderr_chars: int,
    force: bool = False,
) -> dict[str, Any]:
    token_payload = load_antigravity_token_payload(token_path)
    expiry_dt = parse_iso_datetime_lenient(token_payload.get("expiry"))
    try:
        skew_s = int(os.environ.get("ANTIGRAVITY_REFRESH_SKEW_SECONDS", "300"))
    except Exception:
        skew_s = 300
    if skew_s < 0:
        skew_s = 0

    should_refresh = force
    if not should_refresh and expiry_dt is not None:
        should_refresh = (expiry_dt - now).total_seconds() <= float(skew_s)

    if not should_refresh:
        return token_payload

    agy_bin = resolve_antigravity_bin()
    try:
        timeout_s = int(os.environ.get("ANTIGRAVITY_REFRESH_TIMEOUT_S", "45"))
    except Exception:
        timeout_s = 45
    if timeout_s <= 0:
        timeout_s = 45

    res = run_cmd([agy_bin, "models"], timeout_s=timeout_s, env=base_env)
    if res.exit_code != 0:
        errors.append(
            {
                "command": "agy models",
                "exitCode": res.exit_code,
                "message": safe_tail(res.stderr or res.stdout, max_stderr_chars) or f"Exit {res.exit_code}",
            }
        )

    refreshed = load_antigravity_token_payload(token_path)
    return refreshed or token_payload


def antigravity_api_bases() -> list[str]:
    raw = os.environ.get("ANTIGRAVITY_API_BASE_URLS", "")
    if raw.strip():
        bases = [part.strip().rstrip("/") for part in re.split(r"[,\s]+", raw) if part.strip()]
        if bases:
            return bases
    return [
        "https://daily-cloudcode-pa.googleapis.com",
        "https://cloudcode-pa.googleapis.com",
    ]


def post_antigravity_json(base_url: str, path: str, access_token: str, payload: dict[str, Any], *, timeout_s: int) -> tuple[int, Any]:
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        f"{base_url.rstrip('/')}{path}",
        data=data,
        method="POST",
        headers={
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "User-Agent": "antigravity",
            "X-Goog-Api-Client": "google-cloud-sdk vscode_cloudshelleditor/0.1",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout_s) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            return int(getattr(resp, "status", 200) or 200), json.loads(raw) if raw.strip() else {}
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        try:
            payload = json.loads(raw) if raw.strip() else {}
        except Exception:
            payload = {"error": {"message": raw.strip() or f"HTTP {e.code}"}}
        return int(e.code), payload


def antigravity_error_message(status: int, payload: Any) -> str:
    if isinstance(payload, dict):
        err = payload.get("error")
        if isinstance(err, dict):
            msg = str(err.get("message") or "").strip()
            if msg:
                return msg
        msg = str(payload.get("message") or "").strip()
        if msg:
            return msg
    return f"HTTP {status}"


def parse_float(value: Any) -> float | None:
    if isinstance(value, bool):
        return None
    try:
        n = float(value)
    except Exception:
        return None
    return n if n == n and n not in (float("inf"), float("-inf")) else None


def clamp_percent(value: float) -> float:
    if value < 0:
        return 0.0
    if value > 100:
        return 100.0
    return value


def antigravity_model_label(model_id: str) -> str:
    normalized = str(model_id or "").strip().lower()
    normalized = re.sub(r"-(\d)-(\d)(?=-|$)", r"-\1.\2", normalized)
    normalized = normalized.replace("gpt-oss", "gptoss")
    parts = [part for part in re.split(r"[-_\s]+", normalized) if part]
    if not parts:
        return "Model"

    out: list[str] = []
    for part in parts:
        lower = part.lower()
        if lower == "gptoss":
            out.append("GPT-OSS")
        elif lower == "gpt":
            out.append("GPT")
        elif lower == "oss":
            out.append("OSS")
        elif re.fullmatch(r"\d+b", lower):
            out.append(lower.upper())
        elif lower in {"ai", "api"}:
            out.append(lower.upper())
        else:
            out.append(lower[:1].upper() + lower[1:])
    return " ".join(out)


def normalized_antigravity_model_name(value: Any) -> str:
    return re.sub(r"[^a-z0-9]+", " ", str(value or "").lower()).strip()


def antigravity_window_minutes_from_reset(reset_dt: datetime | None, *, now: datetime) -> int:
    if reset_dt is None:
        return 300
    seconds = max(0.0, (reset_dt - now).total_seconds())
    minutes = seconds / 60.0
    if minutes <= 6 * 60:
        return 300
    if minutes <= 36 * 60:
        return 1440
    if minutes <= 9 * 24 * 60:
        return 10080
    return 43200


def antigravity_window_label(minutes: int) -> str:
    if minutes == 300:
        return "Session (5h)"
    if minutes == 10080:
        return "Week (7d)"
    if minutes == 1440:
        return "Window (24h)"
    if minutes == 43200:
        return "Month"
    return f"Window ({minutes}m)"


def antigravity_selected_model() -> str:
    return os.environ.get("ANTIGRAVITY_MODEL", "Claude Opus 4.6 (Thinking)").strip() or "Claude Opus 4.6 (Thinking)"


def compact_duration(seconds: float) -> str:
    total = max(0, int(round(seconds)))
    days, rem = divmod(total, 86400)
    hours, rem = divmod(rem, 3600)
    minutes, secs = divmod(rem, 60)
    if days:
        return f"{days}d {hours}h" if hours else f"{days}d"
    if hours:
        return f"{hours}h {minutes}m" if minutes else f"{hours}h"
    if minutes:
        return f"{minutes}m"
    return f"{secs}s"


def extract_antigravity_plan(load_data: Any) -> str:
    if not isinstance(load_data, dict):
        return "Antigravity"
    current_tier = load_data.get("currentTier")
    if isinstance(current_tier, dict):
        name = str(current_tier.get("name") or "").strip()
        if name:
            return name
    plan_type = str(load_data.get("planType") or "").strip()
    if plan_type:
        return plan_type
    return "Antigravity"


def extract_antigravity_project_id(load_data: Any) -> str | None:
    if not isinstance(load_data, dict):
        return None
    project = load_data.get("cloudaicompanionProject")
    if isinstance(project, str) and project.strip():
        return project.strip()
    if isinstance(project, dict):
        project_id = str(project.get("id") or "").strip()
        if project_id:
            return project_id
    return None


def antigravity_model_windows(models_data: Any, *, now: datetime) -> list[dict[str, Any]]:
    if not isinstance(models_data, dict):
        return []
    models = models_data.get("models")
    if not isinstance(models, dict):
        return []

    windows: list[dict[str, Any]] = []
    selected_model_key = normalized_antigravity_model_name(antigravity_selected_model())
    for order, (model_id, model_info) in enumerate(models.items()):
        model_key = str(model_id or "").strip()
        lower = model_key.lower()
        if not model_key or "chat_" in lower or "tab_" in lower:
            continue
        if not isinstance(model_info, dict):
            continue
        quota = model_info.get("quotaInfo") or model_info.get("quota_info")
        if not isinstance(quota, dict):
            continue
        remaining = parse_float(quota.get("remainingFraction") if "remainingFraction" in quota else quota.get("remaining_fraction"))
        reset_dt = parse_iso_datetime(quota.get("resetTime") or quota.get("reset_time"))
        inferred_exhausted = False
        if remaining is None and reset_dt is not None:
            # Antigravity currently omits remainingFraction for some exhausted
            # premium model rows, but still returns the reset time.
            remaining = 0.0
            inferred_exhausted = True
        if remaining is None:
            continue
        used_percent = clamp_percent((1.0 - remaining) * 100.0)
        label = str(model_info.get("displayName") or "").strip() or antigravity_model_label(model_key)
        normalized_label = normalized_antigravity_model_name(label)
        is_selected = bool(selected_model_key and (selected_model_key == normalized_label or selected_model_key == normalized_antigravity_model_name(model_key)))
        is_recommended = model_info.get("recommended") is True
        window: dict[str, Any] = {
            "label": label,
            "modelId": model_key,
            "usedPercent": round(used_percent, 1),
            "remainingFraction": remaining,
            "windowMinutes": antigravity_window_minutes_from_reset(reset_dt, now=now),
            "inferredExhausted": inferred_exhausted,
            "_order": order,
            "_selected": is_selected,
            "_recommended": is_recommended,
        }
        if reset_dt is not None:
            window["resetsAt"] = reset_dt.replace(microsecond=0).isoformat().replace("+00:00", "Z")
            window["resetDescription"] = f"resets in {compact_duration((reset_dt - now).total_seconds())}"
            window["_resetEpoch"] = reset_dt.timestamp()
        windows.append(window)

    windows.sort(
        key=lambda w: (
            0 if w.get("_selected") else 1,
            -float(w.get("usedPercent") or 0),
            0 if w.get("_recommended") else 1,
            float(w.get("_resetEpoch") or 10**18),
            int(w.get("_order") or 0),
        )
    )
    for window in windows:
        window.pop("_order", None)
        window.pop("_selected", None)
        window.pop("_recommended", None)
        window.pop("_resetEpoch", None)
    return windows[:10]


def antigravity_summary_windows(windows: list[dict[str, Any]]) -> list[dict[str, Any]]:
    by_minutes: dict[int, list[dict[str, Any]]] = {}
    for window in windows:
        try:
            minutes = int(window.get("windowMinutes"))
        except Exception:
            continue
        if minutes <= 0:
            continue
        by_minutes.setdefault(minutes, []).append(window)

    priority = {300: 0, 10080: 1, 1440: 2, 43200: 3}
    summaries: list[dict[str, Any]] = []
    for minutes, group in sorted(by_minutes.items(), key=lambda item: (priority.get(item[0], 99), item[0])):
        best = max(group, key=lambda w: float(w.get("usedPercent") or 0))
        reset_candidates = [parse_iso_datetime(w.get("resetsAt")) for w in group]
        reset_candidates = [dt for dt in reset_candidates if dt is not None]
        reset_dt = min(reset_candidates) if reset_candidates else None
        summary: dict[str, Any] = {
            "label": antigravity_window_label(minutes),
            "usedPercent": round(float(best.get("usedPercent") or 0), 1),
            "windowMinutes": minutes,
            "sourceModel": best.get("label"),
        }
        if reset_dt is not None:
            summary["resetsAt"] = reset_dt.replace(microsecond=0).isoformat().replace("+00:00", "Z")
            summary["resetDescription"] = f"resets in {compact_duration((reset_dt - datetime.now(timezone.utc)).total_seconds())}"
        summaries.append(summary)
    return summaries[:3]


def antigravity_window_minutes_from_name(value: Any) -> int | None:
    normalized = str(value or "").strip().lower()
    if not normalized:
        return None
    if normalized in {"5h", "five_hour", "five-hour", "five hour"}:
        return 300
    if normalized in {"weekly", "week", "7d", "seven_day", "seven-day", "seven day"}:
        return 10080
    if normalized in {"daily", "day", "24h"}:
        return 1440
    match = re.fullmatch(r"(\d+(?:\.\d+)?)h", normalized)
    if match:
        return int(round(float(match.group(1)) * 60))
    match = re.fullmatch(r"(\d+(?:\.\d+)?)d", normalized)
    if match:
        return int(round(float(match.group(1)) * 1440))
    return None


def antigravity_quota_group_score(group: dict[str, Any], selected_model: str) -> int:
    text = normalized_antigravity_model_name(
        " ".join(
            str(part or "")
            for part in (
                group.get("displayName"),
                group.get("description"),
            )
        )
    )
    selected = normalized_antigravity_model_name(selected_model)
    if any(part in selected.split() for part in ("claude", "gpt", "oss", "openai", "anthropic")):
        if any(part in text.split() for part in ("claude", "gpt", "oss", "anthropic")):
            return 0
        if "gemini" in text.split():
            return 10
    if "gemini" in selected.split():
        if "gemini" in text.split():
            return 0
        if any(part in text.split() for part in ("claude", "gpt", "oss", "anthropic")):
            return 10
    return 5


def antigravity_quota_summary_windows(summary_data: Any, *, now: datetime) -> list[dict[str, Any]]:
    if not isinstance(summary_data, dict):
        return []
    groups = summary_data.get("groups")
    if not isinstance(groups, list):
        return []

    valid_groups = [group for group in groups if isinstance(group, dict)]
    if not valid_groups:
        return []

    selected_model = antigravity_selected_model()
    group = sorted(
        valid_groups,
        key=lambda item: (
            antigravity_quota_group_score(item, selected_model),
            str(item.get("displayName") or ""),
        ),
    )[0]
    group_name = str(group.get("displayName") or "").strip() or None
    buckets = group.get("buckets")
    if not isinstance(buckets, list):
        return []

    windows: list[dict[str, Any]] = []
    priority = {300: 0, 10080: 1, 1440: 2, 43200: 3}
    for order, bucket in enumerate(buckets):
        if not isinstance(bucket, dict):
            continue
        remaining = parse_float(bucket.get("remainingFraction") if "remainingFraction" in bucket else bucket.get("remaining_fraction"))
        if remaining is None:
            continue
        minutes = antigravity_window_minutes_from_name(bucket.get("window"))
        if minutes is None:
            reset_dt_for_minutes = parse_iso_datetime(bucket.get("resetTime") or bucket.get("reset_time"))
            minutes = antigravity_window_minutes_from_reset(reset_dt_for_minutes, now=now)
        reset_dt = parse_iso_datetime(bucket.get("resetTime") or bucket.get("reset_time"))
        description = str(bucket.get("description") or "").strip()
        window: dict[str, Any] = {
            "label": antigravity_window_label(minutes),
            "usedPercent": round(clamp_percent((1.0 - remaining) * 100.0), 1),
            "remainingFraction": remaining,
            "windowMinutes": minutes,
            "sourceGroup": group_name,
            "bucketId": bucket.get("bucketId"),
            "bucketName": bucket.get("displayName"),
            "_order": order,
        }
        if reset_dt is not None:
            window["resetsAt"] = reset_dt.replace(microsecond=0).isoformat().replace("+00:00", "Z")
            window["resetDescription"] = description or f"resets in {compact_duration((reset_dt - now).total_seconds())}"
            window["_resetEpoch"] = reset_dt.timestamp()
        elif description:
            window["resetDescription"] = description
        windows.append(window)

    windows.sort(
        key=lambda window: (
            priority.get(int(window.get("windowMinutes") or 0), 99),
            float(window.get("_resetEpoch") or 10**18),
            int(window.get("_order") or 0),
        )
    )
    for window in windows:
        window.pop("_order", None)
        window.pop("_resetEpoch", None)
    return windows[:3]


def antigravity_credits_window(load_data: Any) -> dict[str, Any] | None:
    if not isinstance(load_data, dict):
        return None
    available = parse_float(load_data.get("availablePromptCredits"))
    plan_info = load_data.get("planInfo")
    monthly = None
    if isinstance(plan_info, dict):
        monthly = parse_float(plan_info.get("monthlyPromptCredits"))
    if available is None or monthly is None or monthly <= 0:
        return None
    used = max(0.0, monthly - available)
    return {
        "label": "Credits",
        "usedPercent": round(clamp_percent((used / monthly) * 100.0), 1),
        "availableCredits": available,
        "monthlyCredits": monthly,
        "windowMinutes": 43200,
    }


def fetch_antigravity_api_snapshot(access_token: str, *, timeout_s: int, now: datetime) -> tuple[dict[str, Any] | None, str | None, int]:
    last_error = "No Antigravity API endpoints configured"
    last_status = 1

    for base_url in antigravity_api_bases():
        try:
            status, load_data = post_antigravity_json(
                base_url,
                "/v1internal:loadCodeAssist",
                access_token,
                {
                    "metadata": {
                        "ideType": "ANTIGRAVITY",
                        "platform": "PLATFORM_UNSPECIFIED",
                        "pluginType": "GE" + "MINI",
                    }
                },
                timeout_s=timeout_s,
            )
        except Exception as e:
            last_error = str(e)
            last_status = 1
            continue

        last_status = status
        if status == 401:
            return None, "Token expired", status
        if status < 200 or status >= 300:
            last_error = antigravity_error_message(status, load_data)
            continue

        project_id = extract_antigravity_project_id(load_data)
        model_payload: dict[str, Any] = {"project": project_id} if project_id else {}
        try:
            model_status, models_data = post_antigravity_json(
                base_url,
                "/v1internal:fetchAvailableModels",
                access_token,
                model_payload,
                timeout_s=timeout_s,
            )
        except Exception as e:
            model_status = 1
            models_data = {"error": {"message": str(e)}}

        model_windows = antigravity_model_windows(models_data, now=now) if 200 <= model_status < 300 else []
        quota_status = 1
        quota_data: Any = None
        quota_payload: dict[str, Any] = {"project": project_id} if project_id else {}
        try:
            quota_status, quota_data = post_antigravity_json(
                base_url,
                "/v1internal:retrieveUserQuotaSummary",
                access_token,
                quota_payload,
                timeout_s=timeout_s,
            )
        except Exception as e:
            quota_data = {"error": {"message": str(e)}}
        if quota_status == 401:
            return None, "Token expired", quota_status

        windows = antigravity_quota_summary_windows(quota_data, now=now) if 200 <= quota_status < 300 else []
        if not windows:
            windows = antigravity_summary_windows(model_windows)
        credits_window = antigravity_credits_window(load_data)
        if credits_window:
            windows = [*windows[:2], credits_window, *windows[2:]]

        if not windows and not (200 <= model_status < 300):
            if 200 <= quota_status < 300:
                last_error = antigravity_error_message(model_status, models_data)
                last_status = model_status
            else:
                last_error = antigravity_error_message(quota_status, quota_data)
                last_status = quota_status
            continue

        plan = extract_antigravity_plan(load_data)
        usage: dict[str, Any] = {
            "updatedAt": utc_now_iso(),
            "identity": {
                "providerID": "antigravity",
                "loginMethod": plan,
            },
            "loginMethod": plan,
            "selectedModel": antigravity_selected_model(),
            "primary": windows[0] if len(windows) > 0 else None,
            "secondary": windows[1] if len(windows) > 1 else None,
            "tertiary": windows[2] if len(windows) > 2 else None,
            "modelWindows": model_windows,
        }
        return {
            "provider": "antigravity",
            "source": "api",
            "usage": usage,
        }, None, 0

    return None, last_error, last_status


def collect_antigravity_usage(
    *,
    generated_at: str,
    base_env: dict[str, str],
    usage_timeout_s: int,
    errors: list[dict[str, Any]],
    max_stderr_chars: int,
) -> tuple[dict[str, Any], int]:
    token_path = Path(os.environ.get("ANTIGRAVITY_TOKEN_PATH", str(Path.home() / ".antigravity" / "antigravity-oauth-token")))
    now = datetime.now(timezone.utc)
    token_payload = refresh_antigravity_token_if_needed(
        token_path,
        now=now,
        base_env=base_env,
        errors=errors,
        max_stderr_chars=max_stderr_chars,
    )
    access_token = token_payload.get("accessToken")
    meta = antigravity_token_meta(token_payload, now=now)

    agy_bin = resolve_antigravity_bin()
    version = None
    version_res = run_cmd([agy_bin, "--version"], timeout_s=10, env=base_env)
    if version_res.exit_code == 0:
        version = (version_res.stdout or "").strip() or None

    if not isinstance(access_token, str) or not access_token.strip():
        entry = {
            "provider": "antigravity",
            "source": "api",
            "version": version,
            "auth": meta,
            "updatedAt": generated_at,
            "error": {
                "kind": "provider",
                "code": 1,
                "message": f"Antigravity token not found at {token_path}",
            },
        }
        return entry, 1

    snapshot, err, exit_code = fetch_antigravity_api_snapshot(access_token.strip(), timeout_s=usage_timeout_s, now=now)
    if err == "Token expired":
        token_payload = refresh_antigravity_token_if_needed(
            token_path,
            now=now,
            base_env=base_env,
            errors=errors,
            max_stderr_chars=max_stderr_chars,
            force=True,
        )
        access_token = token_payload.get("accessToken")
        meta = antigravity_token_meta(token_payload, now=now)
        if isinstance(access_token, str) and access_token.strip():
            snapshot, err, exit_code = fetch_antigravity_api_snapshot(access_token.strip(), timeout_s=usage_timeout_s, now=now)

    if snapshot is not None:
        snapshot["version"] = version
        snapshot["auth"] = meta
        return snapshot, 0

    entry = {
        "provider": "antigravity",
        "source": "api",
        "version": version,
        "auth": meta,
        "updatedAt": generated_at,
        "error": {
            "kind": "provider",
            "code": exit_code or 1,
            "message": err or "Antigravity usage fetch failed",
        },
    }
    return entry, exit_code or 1


def read_tail_lines(path: Path, *, max_bytes: int) -> list[str]:
    try:
        with path.open("rb") as f:
            f.seek(0, os.SEEK_END)
            end = f.tell()
            start = max(0, end - max_bytes)
            f.seek(start)
            chunk = f.read(end - start)
    except Exception:
        return []

    if start > 0:
        nl = chunk.find(b"\n")
        if nl >= 0:
            chunk = chunk[nl + 1 :]
        else:
            return []

    text = chunk.decode("utf-8", errors="replace")
    return [line for line in text.splitlines() if line.strip()]


def is_claude_model(value: Any) -> bool:
    return isinstance(value, str) and value.startswith("claude-")


def discover_clawdbot_state_dirs() -> list[Path]:
    candidates: list[Path] = []
    for base in (Path("/root"), Path("/home/web"), Path("/root/ClawBridgeGateway/state")):
        if not base.exists():
            continue
        for child in base.glob(".clawdbot*"):
            if child.is_dir():
                candidates.append(child)
        for child in base.glob(".clawdbot-state*"):
            if child.is_dir():
                candidates.append(child)

    out: list[Path] = []
    seen: set[str] = set()
    for d in candidates:
        try:
            key = str(d.resolve())
        except Exception:
            key = str(d)
        if key in seen:
            continue
        seen.add(key)
        out.append(d)
    return out


def find_last_claude_cli_event(*, home: Path, exclude_project_dirs: set[Path], max_files: int, max_bytes: int) -> dict[str, Any] | None:
    projects_dir = home / ".claude" / "projects"
    history_file = home / ".claude" / "history.jsonl"

    candidates: list[Path] = []
    if projects_dir.is_dir():
        candidates.extend(projects_dir.glob("**/*.jsonl"))
    if history_file.is_file():
        candidates.append(history_file)

    candidates = [p for p in candidates if p.is_file() and p.suffix == ".jsonl"]
    candidates.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    if max_files > 0:
        candidates = candidates[:max_files]

    best: dict[str, Any] | None = None
    for path in candidates:
        if any(excl in path.parents for excl in exclude_project_dirs):
            continue

        for line in reversed(read_tail_lines(path, max_bytes=max_bytes)):
            try:
                entry = json.loads(line)
            except Exception:
                continue
            if not isinstance(entry, dict):
                continue
            msg = entry.get("message")
            if not isinstance(msg, dict):
                continue
            model = msg.get("model")
            if not is_claude_model(model):
                continue
            ts = parse_iso_datetime(entry.get("timestamp")) or parse_iso_datetime(msg.get("timestamp"))
            if ts is None:
                continue
            item = {
                "tsUtc": ts.strftime("%Y-%m-%dT%H:%M:%SZ"),
                "source": "cli",
                "provider": "claude-cli",
                "model": str(model),
                "path": str(path),
                "cwd": entry.get("cwd") if isinstance(entry.get("cwd"), str) else None,
            }
            if best is None or str(item["tsUtc"]) > str(best.get("tsUtc")):
                best = item
            break

    return best


def find_last_claude_bot_event(*, state_dirs: list[Path], max_files: int, max_bytes: int) -> dict[str, Any] | None:
    candidates: list[Path] = []
    for state_dir in state_dirs:
        agents_dir = state_dir / "agents"
        if not agents_dir.is_dir():
            continue
        candidates.extend(sorted(agents_dir.glob("*/sessions/*.jsonl")))

    candidates.sort(key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
    if max_files > 0:
        candidates = candidates[:max_files]

    best: dict[str, Any] | None = None
    for path in candidates:
        for line in reversed(read_tail_lines(path, max_bytes=max_bytes)):
            try:
                entry = json.loads(line)
            except Exception:
                continue
            if not isinstance(entry, dict):
                continue
            if entry.get("type") != "message":
                continue
            msg = entry.get("message")
            if not isinstance(msg, dict) or msg.get("role") != "assistant":
                continue

            provider = msg.get("provider") or entry.get("provider")
            model = msg.get("model") or entry.get("model")
            provider_value = str(provider or "").strip().lower()
            if not (is_claude_model(model) or provider_value in ("anthropic", "claude")):
                continue

            ts = parse_iso_datetime(entry.get("timestamp")) or parse_iso_datetime(msg.get("timestamp"))
            if ts is None:
                continue

            item = {
                "tsUtc": ts.strftime("%Y-%m-%dT%H:%M:%SZ"),
                "source": "bots",
                "provider": str(provider) if isinstance(provider, str) else None,
                "model": str(model) if isinstance(model, str) else None,
                "path": str(path),
            }
            if best is None or str(item["tsUtc"]) > str(best.get("tsUtc")):
                best = item
            break

    return best


def compute_last_claude_activity(*, max_files: int, max_bytes: int) -> dict[str, Any]:
    exclude_refresh = {Path("/root/.claude/projects/-home-mlweb-stats-lucheestiy-com")}
    cli_root = find_last_claude_cli_event(
        home=Path("/root"),
        exclude_project_dirs=exclude_refresh,
        max_files=max_files,
        max_bytes=max_bytes,
    )
    cli_web = find_last_claude_cli_event(
        home=Path("/home/web"),
        exclude_project_dirs=set(),
        max_files=max_files,
        max_bytes=max_bytes,
    )
    bots = find_last_claude_bot_event(
        state_dirs=discover_clawdbot_state_dirs(),
        max_files=max_files,
        max_bytes=max_bytes,
    )

    candidates = [c for c in (cli_root, cli_web, bots) if isinstance(c, dict) and isinstance(c.get("tsUtc"), str)]
    overall = None
    if candidates:
        overall = max(candidates, key=lambda d: str(d.get("tsUtc") or ""))

    return {
        "generatedAt": utc_now_iso(),
        "cli": {"root": cli_root, "web": cli_web},
        "bots": bots,
        "overall": overall,
        "excluded": {"refreshProject": "/root/.claude/projects/-home-mlweb-stats-lucheestiy-com"},
    }


def as_int(value: Any) -> int:
    try:
        if isinstance(value, bool):
            return 0
        return int(value)
    except Exception:
        return 0


def extract_text(value: Any) -> str:
    if isinstance(value, str):
        return value.strip()
    if isinstance(value, list):
        parts: list[str] = []
        for item in value:
            if isinstance(item, str):
                text = item.strip()
                if text:
                    parts.append(text)
            elif isinstance(item, dict):
                text = str(item.get("text") or item.get("message") or "").strip()
                if text:
                    parts.append(text)
        return "\n".join(parts).strip()
    if isinstance(value, dict):
        text = str(value.get("text") or value.get("message") or "").strip()
        if text:
            return text
    return ""


def clip_text(value: str, max_len: int = 160) -> str:
    collapsed = " ".join((value or "").split())
    if len(collapsed) <= max_len:
        return collapsed
    return collapsed[: max_len - 1] + "…"


def load_claude_account_metadata() -> dict[str, Any]:
    account_email = None
    billing_type = None
    auth_type = None

    config_paths = [
        Path("/root/.claude/.config.json"),
        Path("/root/.claude.json"),
        Path("/home/web/.claude/.config.json"),
        Path("/home/web/.claude.json"),
    ]
    credential_paths = [
        Path("/root/.claude/.credentials.json"),
        Path("/home/web/.claude/.credentials.json"),
    ]

    for path in config_paths:
        raw = load_json(path)
        if not isinstance(raw, dict):
            continue
        oauth_account = raw.get("oauthAccount")
        if isinstance(oauth_account, dict):
            if account_email is None:
                value = str(oauth_account.get("emailAddress") or "").strip()
                if value:
                    account_email = value
            if billing_type is None:
                value = str(oauth_account.get("billingType") or "").strip()
                if value:
                    billing_type = value
            auth_type = auth_type or "oauth"

    for path in credential_paths:
        raw = load_json(path)
        if not isinstance(raw, dict):
            continue
        oauth = raw.get("claudeAiOauth")
        if isinstance(oauth, dict) and oauth:
            auth_type = auth_type or "oauth"

    if auth_type is None:
        auth_type = "unknown"

    return {
        "activeAccount": account_email,
        "billingType": billing_type,
        "authType": auth_type,
    }


def collect_shared_claude_responses() -> list[dict[str, Any]]:
    project_files: list[Path] = []
    exclude_project_dirs = {Path("/root/.claude/projects/-home-mlweb-stats-lucheestiy-com")}

    try:
        max_files = int(os.environ.get("CLAUDE_SHARED_STATS_MAX_FILES", "800"))
    except Exception:
        max_files = 800
    if max_files <= 0:
        max_files = 800

    for home in (Path("/root"), Path("/home/web")):
        projects_dir = home / ".claude" / "projects"
        if not projects_dir.is_dir():
            continue
        project_files.extend(path for path in projects_dir.glob("*/*.jsonl") if path.is_file())

    project_files.sort(key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
    if max_files > 0:
        project_files = project_files[:max_files]

    responses_by_id: dict[str, dict[str, Any]] = {}

    def should_replace_response(existing: dict[str, Any], candidate: dict[str, Any]) -> bool:
        existing_tokens = as_int(existing.get("totalTokens")) or 0
        candidate_tokens = as_int(candidate.get("totalTokens")) or 0
        if candidate_tokens != existing_tokens:
            return candidate_tokens > existing_tokens

        existing_created_at = str(existing.get("createdAt") or "")
        candidate_created_at = str(candidate.get("createdAt") or "")
        if candidate_created_at != existing_created_at:
            return candidate_created_at > existing_created_at

        existing_meta = int(bool(existing.get("model"))) + int(bool(existing.get("version")))
        candidate_meta = int(bool(candidate.get("model"))) + int(bool(candidate.get("version")))
        return candidate_meta > existing_meta

    for project_path in project_files:
        if any(excl in project_path.parents for excl in exclude_project_dirs):
            continue

        session_id = project_path.stem
        last_user = ""

        try:
            f = project_path.open("r", encoding="utf-8", errors="replace")
        except Exception:
            continue

        with f:
            for raw in f:
                raw = raw.strip()
                if not raw:
                    continue

                try:
                    event = json.loads(raw)
                except Exception:
                    continue
                if not isinstance(event, dict):
                    continue

                msg = event.get("message")
                if not isinstance(msg, dict):
                    continue

                role = str(msg.get("role") or "")
                if role == "user":
                    if bool(event.get("isMeta")):
                        continue
                    user_text = extract_text(msg.get("content"))
                    if user_text:
                        user_text = user_text.strip()
                        if not (
                            user_text.startswith("<local-command")
                            or user_text.startswith("<command-name>")
                            or user_text.startswith("<command-message>")
                            or user_text.startswith("<command-args>")
                        ):
                            last_user = user_text
                    continue

                usage = msg.get("usage")
                if not isinstance(usage, dict):
                    continue

                if role and role != "assistant":
                    continue

                event_type = str(event.get("type") or "")
                if event_type and event_type != "assistant":
                    continue

                model = str(msg.get("model") or "").strip()
                if not is_claude_model(model):
                    continue

                ts_dt = parse_iso_datetime(event.get("timestamp")) or parse_iso_datetime(msg.get("timestamp"))
                if ts_dt is None:
                    continue
                created_at = ts_dt.strftime("%Y-%m-%dT%H:%M:%SZ")

                version = str(event.get("version") or "").strip()
                input_tokens = as_int(usage.get("input_tokens"))
                output_tokens = as_int(usage.get("output_tokens"))
                cache_read_tokens = as_int(usage.get("cache_read_input_tokens"))
                cache_create_tokens = as_int(usage.get("cache_creation_input_tokens"))
                total_tokens = as_int(usage.get("total_tokens"))
                if total_tokens <= 0:
                    total_tokens = input_tokens + output_tokens + cache_read_tokens + cache_create_tokens
                if total_tokens <= 0:
                    total_tokens = 1

                response_id = str(msg.get("id") or event.get("requestId") or f"{session_id}:{created_at}")
                candidate = {
                    "createdAt": created_at,
                    "sessionId": session_id,
                    "command": clip_text(last_user or "(assistant reply)"),
                    "model": model,
                    "version": version or None,
                    "inputTokens": input_tokens,
                    "outputTokens": output_tokens,
                    "cacheReadTokens": cache_read_tokens,
                    "cacheCreationTokens": cache_create_tokens,
                    "totalTokens": total_tokens,
                }

                existing = responses_by_id.get(response_id)
                if existing is None or should_replace_response(existing, candidate):
                    responses_by_id[response_id] = candidate

    responses = list(responses_by_id.values())
    responses.sort(key=lambda x: x.get("createdAt") or "", reverse=True)
    return responses


def build_shared_claude_history_entries(
    responses: list[dict[str, Any]],
    *,
    now: datetime,
    max_days: int = 30,
) -> list[dict[str, Any]]:
    cutoff = now - timedelta(days=max_days)
    entries: list[dict[str, Any]] = []

    for item in responses:
        if not isinstance(item, dict):
            continue
        dt = parse_iso_datetime(item.get("createdAt"))
        if dt is None or dt < cutoff:
            continue

        total_tokens = as_int(item.get("totalTokens"))
        if total_tokens <= 0:
            total_tokens = 1

        dt_local = dt.astimezone()
        entries.append(
            {
                "id": f"claude:{item.get('sessionId') or ''}:{item.get('createdAt') or ''}",
                "ts": dt.strftime("%Y-%m-%dT%H:%M:%SZ"),
                "hour": dt_local.hour,
                "day": dt_local.strftime("%Y-%m-%d"),
                "provider": "claude",
                "account": "",
                "activity": float(total_tokens),
                "sessionPct": round(min(100.0, float(total_tokens) / 100.0), 3),
                "totalTokens": total_tokens,
                "sessionId": item.get("sessionId"),
                "model": item.get("model"),
                "command": item.get("command"),
                "source": "claude-transcript",
            }
        )

    entries.sort(key=lambda x: str(x.get("ts") or ""))
    return entries


def collect_shared_claude_stats(
    now: datetime,
    *,
    responses: list[dict[str, Any]] | None = None,
    metadata: dict[str, Any] | None = None,
) -> dict[str, Any]:
    metadata = metadata or load_claude_account_metadata()
    responses = responses if isinstance(responses, list) else collect_shared_claude_responses()
    if not responses:
        return {
            "status": "disabled",
            "lastUpdated": utc_now_iso(),
            "version": None,
            "totalResponses": 0,
            "responses24h": 0,
            "responses7d": 0,
            "tokens24h": 0,
            "tokens7d": 0,
            "activeAccount": metadata.get("activeAccount"),
            "authType": metadata.get("authType"),
            "billingType": metadata.get("billingType"),
            "recentResponses": [],
        }

    responses.sort(key=lambda x: x.get("createdAt") or "", reverse=True)
    day_ago = now - timedelta(days=1)
    week_ago = now - timedelta(days=7)

    responses24 = [r for r in responses if (parse_iso_datetime(r.get("createdAt")) or now) >= day_ago]
    responses7 = [r for r in responses if (parse_iso_datetime(r.get("createdAt")) or now) >= week_ago]

    latest_version = None
    for item in responses:
        value = str(item.get("version") or "").strip()
        if value:
            latest_version = value
            break

    return {
        "status": "ready",
        "lastUpdated": utc_now_iso(),
        "version": latest_version,
        "totalResponses": len(responses),
        "responses24h": len(responses24),
        "responses7d": len(responses7),
        "tokens24h": sum(as_int(r.get("totalTokens")) for r in responses24),
        "tokens7d": sum(as_int(r.get("totalTokens")) for r in responses7),
        "activeAccount": metadata.get("activeAccount"),
        "authType": metadata.get("authType"),
        "billingType": metadata.get("billingType"),
        "recentResponses": responses[:30],
    }


def to_ymd_in_tz(dt_utc: datetime, tz_name: str) -> str:
    try:
        tz = ZoneInfo(tz_name)
    except Exception:
        return ""
    try:
        return dt_utc.astimezone(tz).date().isoformat()
    except Exception:
        return ""


def as_finite_number(value: Any) -> float | None:
    if value is None:
        return None
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        n = float(value)
        return n if n >= 0 and n != float("inf") and n == n else None
    return None


@lru_cache(maxsize=1)
def minimax_pricing_usd_per_million_tokens() -> dict[str, float]:
    def env_float(name: str, default: float) -> float:
        value = os.environ.get(name)
        if value is None:
            return default
        try:
            parsed = float(value)
        except Exception:
            return default
        return parsed if parsed >= 0 and parsed == parsed and parsed != float("inf") else default

    return {
        "input": env_float("MINIMAX_COST_INPUT_PER_MILLION_USD", 0.3),
        "output": env_float("MINIMAX_COST_OUTPUT_PER_MILLION_USD", 1.2),
        "cacheRead": env_float("MINIMAX_COST_CACHE_READ_PER_MILLION_USD", 0.03),
        "cacheWrite": env_float("MINIMAX_COST_CACHE_WRITE_PER_MILLION_USD", 0.375),
    }


def compute_minimax_cost_usd(
    *,
    input_tokens: float | None,
    output_tokens: float | None,
    cache_read_tokens: float | None,
    cache_write_tokens: float | None,
) -> float:
    pricing = minimax_pricing_usd_per_million_tokens()
    return (
        (input_tokens or 0.0) * pricing["input"]
        + (output_tokens or 0.0) * pricing["output"]
        + (cache_read_tokens or 0.0) * pricing["cacheRead"]
        + (cache_write_tokens or 0.0) * pricing["cacheWrite"]
    ) / 1_000_000.0


def get_daily_models(day_entry: dict[str, Any]) -> list[str]:
    models: list[str] = []
    models_used = day_entry.get("modelsUsed")
    if isinstance(models_used, list):
        for value in models_used:
            if isinstance(value, str) and value:
                models.append(value)

    model_breakdowns = day_entry.get("modelBreakdowns")
    if isinstance(model_breakdowns, list):
        for mb in model_breakdowns:
            if not isinstance(mb, dict):
                continue
            name = mb.get("modelName")
            if isinstance(name, str) and name:
                models.append(name)

    # Keep order stable while removing duplicates.
    seen: set[str] = set()
    out: list[str] = []
    for m in models:
        if m in seen:
            continue
        seen.add(m)
        out.append(m)
    return out


def estimate_codex_token_cost_rates(
    daily_entries: list[Any], *, model_name: str
) -> tuple[float | None, float | None, float | None]:
    """
    Estimate USD/token rates for one priced model from codexbar daily aggregates.
    Returns (input_rate, output_rate, blended_rate).
    """
    samples: list[tuple[float, float, float]] = []
    total_cost_sum = 0.0
    total_tokens_sum = 0.0

    for entry in daily_entries:
        if not isinstance(entry, dict):
            continue
        total_cost = as_finite_number(entry.get("totalCost"))
        if total_cost is None:
            continue

        models = get_daily_models(entry)
        if not models:
            continue
        if any(m != model_name for m in models):
            continue

        input_tokens = as_finite_number(entry.get("inputTokens")) or 0.0
        output_tokens = as_finite_number(entry.get("outputTokens")) or 0.0
        total_tokens = input_tokens + output_tokens
        if total_tokens <= 0:
            continue

        samples.append((input_tokens, output_tokens, total_cost))
        total_cost_sum += total_cost
        total_tokens_sum += total_tokens

    if total_tokens_sum <= 0:
        return None, None, None

    blended_rate = total_cost_sum / total_tokens_sum

    # Fit cost ~= input * a + output * b via least squares.
    if len(samples) >= 2:
        s_ii = 0.0
        s_io = 0.0
        s_oo = 0.0
        s_ic = 0.0
        s_oc = 0.0
        for i_tokens, o_tokens, cost in samples:
            s_ii += i_tokens * i_tokens
            s_io += i_tokens * o_tokens
            s_oo += o_tokens * o_tokens
            s_ic += i_tokens * cost
            s_oc += o_tokens * cost

        det = (s_ii * s_oo) - (s_io * s_io)
        if abs(det) > 1e-12:
            input_rate = ((s_ic * s_oo) - (s_oc * s_io)) / det
            output_rate = ((s_ii * s_oc) - (s_io * s_ic)) / det
            if (
                input_rate == input_rate
                and output_rate == output_rate
                and input_rate >= 0
                and output_rate >= 0
                and input_rate != float("inf")
                and output_rate != float("inf")
            ):
                return input_rate, output_rate, blended_rate

    return None, None, blended_rate


def apply_codex_model_alias_pricing(
    cost_items: list[Any], *, alias_model: str, priced_model: str
) -> None:
    """
    Temporary fallback for models that codexbar reports without priced cost.
    If alias_model should be priced like priced_model, backfill missing daily
    totalCost from token usage for codex provider.
    """
    for item in cost_items:
        if not isinstance(item, dict):
            continue
        if item.get("provider") != "codex":
            continue

        daily = item.get("daily")
        if not isinstance(daily, list) or not daily:
            continue

        input_rate, output_rate, blended_rate = estimate_codex_token_cost_rates(daily, model_name=priced_model)
        if blended_rate is None:
            continue

        added_total_cost = 0.0
        for entry in daily:
            if not isinstance(entry, dict):
                continue
            if as_finite_number(entry.get("totalCost")) is not None:
                continue

            models = get_daily_models(entry)
            if not models:
                continue

            mapped = {priced_model if model == alias_model else model for model in models}
            if mapped != {priced_model}:
                continue

            input_tokens = as_finite_number(entry.get("inputTokens")) or 0.0
            output_tokens = as_finite_number(entry.get("outputTokens")) or 0.0
            total_tokens = as_finite_number(entry.get("totalTokens"))
            if total_tokens is None:
                total_tokens = input_tokens + output_tokens

            if input_rate is not None and output_rate is not None:
                estimated_cost = (input_tokens * input_rate) + (output_tokens * output_rate)
            else:
                estimated_cost = (total_tokens or 0.0) * blended_rate

            if estimated_cost < 0:
                continue

            entry["totalCost"] = estimated_cost
            added_total_cost += estimated_cost

            # If this day has a single unpriced breakdown entry for the alias,
            # backfill it too so model-level views remain consistent.
            model_breakdowns = entry.get("modelBreakdowns")
            if isinstance(model_breakdowns, list):
                unresolved_alias: list[dict[str, Any]] = []
                for mb in model_breakdowns:
                    if not isinstance(mb, dict):
                        continue
                    name = mb.get("modelName")
                    if name != alias_model:
                        continue
                    if as_finite_number(mb.get("cost")) is None:
                        unresolved_alias.append(mb)
                if len(unresolved_alias) == 1:
                    unresolved_alias[0]["cost"] = estimated_cost

        if added_total_cost <= 0:
            continue

        totals = item.get("totals")
        if not isinstance(totals, dict):
            totals = {}
            item["totals"] = totals

        totals["totalCost"] = (as_finite_number(totals.get("totalCost")) or 0.0) + added_total_cost
        item["last30DaysCostUSD"] = (as_finite_number(item.get("last30DaysCostUSD")) or 0.0) + added_total_cost


def compute_clawdbot_cost_delta(
    *,
    tz_name: str,
    days: int,
    errors: list[dict[str, Any]],
    max_stderr_chars: int,
    provider: str,
    source: str,
    state_dir: Path | None = None,
    match_providers: tuple[str, ...] | None = None,
    match_model_prefixes: tuple[str, ...] | None = None,
) -> dict[str, Any] | None:
    """
    Clawdbot stores per-message usage+cost in ~/.clawdbot*/agents/*/sessions/*.jsonl.
    CodexBar's `cost` scanner doesn't see these, so we merge them into the
    relevant cost provider.
    """
    if state_dir is None:
        state_dir = Path(os.environ.get("CLAWDBOT_STATE_DIR", str(Path.home() / ".clawdbot")))

    provider_out = str(provider or "").strip() or "unknown"
    source_out = str(source or "").strip() or "clawdbot"
    provider_match = tuple(match_providers) if match_providers is not None else (provider_out,)
    provider_match_lower = tuple(str(p).strip().lower() for p in provider_match if str(p).strip())
    model_prefixes = tuple(match_model_prefixes) if match_model_prefixes is not None else tuple()

    agents_dir = state_dir / "agents"
    if not agents_dir.is_dir():
        return None

    now_utc = datetime.now(timezone.utc)
    # Include "today" as one of the days (align with dashboard 30d windows).
    since_utc = now_utc - timedelta(days=max(1, days) - 1)
    since_ts_s = since_utc.timestamp()

    daily: dict[str, dict[str, Any]] = {}
    totals: dict[str, float] = {
        "inputTokens": 0.0,
        "outputTokens": 0.0,
        "cacheReadTokens": 0.0,
        "cacheCreationTokens": 0.0,
        "totalTokens": 0.0,
        "totalCost": 0.0,
        "missingCostEntries": 0.0,
    }

    session_files = sorted(agents_dir.glob("*/sessions/*.jsonl"))
    for path in session_files:
        if path.name.endswith(".jsonl.lock"):
            continue
        try:
            st = path.stat()
        except Exception:
            continue
        if st.st_mtime < since_ts_s:
            continue

        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        entry = json.loads(line)
                    except Exception:
                        continue
                    if not isinstance(entry, dict):
                        continue
                    if entry.get("type") != "message":
                        continue
                    msg = entry.get("message")
                    if not isinstance(msg, dict):
                        continue
                    if msg.get("role") != "assistant":
                        continue

                    provider = msg.get("provider") or entry.get("provider")
                    model = msg.get("model") or entry.get("model")
                    provider_value = str(provider or "").strip().lower()
                    model_value = str(model or "")
                    if provider_match_lower and provider_value not in provider_match_lower and not any(
                        model_value.startswith(prefix) for prefix in model_prefixes
                    ):
                        continue

                    usage = msg.get("usage") or entry.get("usage")
                    if not isinstance(usage, dict):
                        continue

                    dt_utc = parse_iso_datetime(entry.get("timestamp")) or parse_iso_datetime(msg.get("timestamp"))
                    if dt_utc is None or dt_utc.timestamp() < since_ts_s:
                        continue
                    day = to_ymd_in_tz(dt_utc, tz_name)
                    if not day:
                        continue

                    bucket = daily.get(day)
                    if bucket is None:
                        bucket = {
                            "date": day,
                            "inputTokens": 0.0,
                            "outputTokens": 0.0,
                            "cacheReadTokens": 0.0,
                            "cacheCreationTokens": 0.0,
                            "totalTokens": 0.0,
                            "totalCost": 0.0,
                            "missingCostEntries": 0.0,
                            "modelsUsed": set(),
                            "modelCosts": {},
                        }
                        daily[day] = bucket

                    input_tokens = as_finite_number(usage.get("input"))
                    output_tokens = as_finite_number(usage.get("output"))
                    cache_read = as_finite_number(usage.get("cacheRead"))
                    cache_write = as_finite_number(usage.get("cacheWrite"))
                    total_tokens = as_finite_number(usage.get("totalTokens")) or as_finite_number(usage.get("total"))
                    if total_tokens is None:
                        total_tokens = (input_tokens or 0.0) + (output_tokens or 0.0) + (cache_read or 0.0) + (cache_write or 0.0)

                    cost_total = None
                    if provider_value == "minimax":
                        if input_tokens is None and output_tokens is None and cache_read is None and cache_write is None:
                            bucket["missingCostEntries"] += 1.0
                            totals["missingCostEntries"] += 1.0
                            cost_total = 0.0
                        else:
                            cost_total = compute_minimax_cost_usd(
                                input_tokens=input_tokens,
                                output_tokens=output_tokens,
                                cache_read_tokens=cache_read,
                                cache_write_tokens=cache_write,
                            )
                    else:
                        cost = usage.get("cost")
                        if isinstance(cost, dict):
                            cost_total = as_finite_number(cost.get("total"))
                        if cost_total is None:
                            bucket["missingCostEntries"] += 1.0
                            totals["missingCostEntries"] += 1.0
                            cost_total = 0.0

                    bucket["inputTokens"] += input_tokens or 0.0
                    bucket["outputTokens"] += output_tokens or 0.0
                    bucket["cacheReadTokens"] += cache_read or 0.0
                    bucket["cacheCreationTokens"] += cache_write or 0.0
                    bucket["totalTokens"] += total_tokens
                    bucket["totalCost"] += cost_total

                    totals["inputTokens"] += input_tokens or 0.0
                    totals["outputTokens"] += output_tokens or 0.0
                    totals["cacheReadTokens"] += cache_read or 0.0
                    totals["cacheCreationTokens"] += cache_write or 0.0
                    totals["totalTokens"] += total_tokens
                    totals["totalCost"] += cost_total

                    if isinstance(model, str) and model:
                        bucket["modelsUsed"].add(model)
                        model_costs = bucket["modelCosts"]
                        prev_cost = model_costs.get(model, 0.0)
                        model_costs[model] = prev_cost + cost_total
        except Exception as e:
            errors.append(
                {
                    "command": "clawdbot transcripts scan",
                    "exitCode": 1,
                    "message": safe_tail(str(e), max_stderr_chars) or "Failed to scan Clawdbot sessions",
                }
            )

    if not daily:
        return None

    daily_items: list[dict[str, Any]] = []
    for day in sorted(daily.keys()):
        b = daily[day]
        model_breakdowns = [
            {"modelName": name, "cost": cost} for name, cost in sorted(b["modelCosts"].items(), key=lambda kv: kv[1], reverse=True)
        ]
        models_used = sorted(b["modelsUsed"])
        daily_items.append(
            {
                "date": b["date"],
                "inputTokens": b["inputTokens"],
                "outputTokens": b["outputTokens"],
                "cacheReadTokens": b["cacheReadTokens"],
                "cacheCreationTokens": b["cacheCreationTokens"],
                "totalTokens": b["totalTokens"],
                "totalCost": b["totalCost"],
                "modelBreakdowns": model_breakdowns,
                "modelsUsed": models_used,
            }
            )

    return {
        "updatedAt": utc_now_iso(),
        "provider": provider_out,
        "source": source_out,
        "totals": {
            "inputTokens": totals["inputTokens"],
            "outputTokens": totals["outputTokens"],
            "cacheReadTokens": totals["cacheReadTokens"],
            "cacheCreationTokens": totals["cacheCreationTokens"],
            "totalTokens": totals["totalTokens"],
            "totalCost": totals["totalCost"],
        },
        "daily": daily_items,
        "last30DaysTokens": totals["totalTokens"],
        "last30DaysCostUSD": totals["totalCost"],
    }


def compute_clawdbot_window_usage(
    *,
    provider: str,
    state_dir: Path,
    window_minutes: int,
    budget_usd: float,
    reset_offset_minutes: int,
    errors: list[dict[str, Any]],
    max_stderr_chars: int,
) -> dict[str, Any] | None:
    """
    Best-effort "usage" for providers that don't have a CodexBar usage fetch
    strategy on this host. Derives a 5h window from Clawdbot transcripts and
    treats the spend within that window as % of a configured budget.
    """
    agents_dir = state_dir / "agents"
    if not agents_dir.is_dir():
        return None

    provider_value = str(provider or "").strip() or "unknown"
    window_minutes = int(window_minutes or 0)
    if window_minutes <= 0:
        window_minutes = 300

    budget = float(budget_usd or 0.0)
    if budget < 0 or budget != budget:
        budget = 0.0

    now_utc = datetime.now(timezone.utc)
    now_ts = now_utc.timestamp()
    window_s = float(window_minutes) * 60.0
    offset_s = float(int(reset_offset_minutes or 0) * 60)
    window_index = int((now_ts - offset_s) // window_s)
    window_start_s = window_index * window_s + offset_s
    window_end_s = window_start_s + window_s

    window_end_dt = datetime.fromtimestamp(window_end_s, tz=timezone.utc)
    resets_at = window_end_dt.strftime("%Y-%m-%dT%H:%M:%SZ")

    totals: dict[str, float] = {
        "totalTokens": 0.0,
        "totalCost": 0.0,
        "missingCostEntries": 0.0,
    }

    session_files = sorted(agents_dir.glob("*/sessions/*.jsonl"))
    for path in session_files:
        if path.name.endswith(".jsonl.lock"):
            continue
        try:
            st = path.stat()
        except Exception:
            continue
        if st.st_mtime < window_start_s:
            continue

        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        entry = json.loads(line)
                    except Exception:
                        continue
                    if not isinstance(entry, dict):
                        continue
                    if entry.get("type") != "message":
                        continue
                    msg = entry.get("message")
                    if not isinstance(msg, dict):
                        continue
                    if msg.get("role") != "assistant":
                        continue

                    p = msg.get("provider") or entry.get("provider")
                    if str(p or "").strip().lower() != provider_value.lower():
                        continue

                    usage = msg.get("usage") or entry.get("usage")
                    if not isinstance(usage, dict):
                        continue

                    dt_utc = parse_iso_datetime(entry.get("timestamp")) or parse_iso_datetime(msg.get("timestamp"))
                    if dt_utc is None:
                        continue
                    ts = dt_utc.timestamp()
                    if ts < window_start_s or ts >= window_end_s:
                        continue

                    input_tokens = as_finite_number(usage.get("input"))
                    output_tokens = as_finite_number(usage.get("output"))
                    cache_read = as_finite_number(usage.get("cacheRead"))
                    cache_write = as_finite_number(usage.get("cacheWrite"))
                    total_tokens = as_finite_number(usage.get("totalTokens")) or as_finite_number(usage.get("total"))
                    if total_tokens is None:
                        total_tokens = (input_tokens or 0.0) + (output_tokens or 0.0) + (cache_read or 0.0) + (cache_write or 0.0)

                    cost_total = None
                    if provider_value.lower() == "minimax":
                        if input_tokens is None and output_tokens is None and cache_read is None and cache_write is None:
                            totals["missingCostEntries"] += 1.0
                            cost_total = 0.0
                        else:
                            cost_total = compute_minimax_cost_usd(
                                input_tokens=input_tokens,
                                output_tokens=output_tokens,
                                cache_read_tokens=cache_read,
                                cache_write_tokens=cache_write,
                            )
                    else:
                        cost = usage.get("cost")
                        if isinstance(cost, dict):
                            cost_total = as_finite_number(cost.get("total"))
                        if cost_total is None:
                            totals["missingCostEntries"] += 1.0
                            cost_total = 0.0

                    totals["totalTokens"] += total_tokens
                    totals["totalCost"] += cost_total
        except Exception as e:
            errors.append(
                {
                    "command": "clawdbot transcripts scan",
                    "provider": provider_value,
                    "exitCode": 1,
                    "message": safe_tail(str(e), max_stderr_chars) or "Failed to scan Clawdbot sessions",
                }
            )

    used_percent = 0.0
    if budget > 0:
        used_percent = (totals["totalCost"] / budget) * 100.0

    login_method = f"Coding subscription (${budget:g})" if budget > 0 else "Coding subscription"

    return {
        "updatedAt": utc_now_iso(),
        "identity": {
            "loginMethod": login_method,
            "providerID": provider_value,
        },
        "primary": {
            "usedPercent": used_percent,
            "resetsAt": resets_at,
            "windowMinutes": window_minutes,
        },
        "secondary": None,
        "tertiary": None,
        "loginMethod": login_method,
        "window": {
            "budgetUSD": budget,
            "totalCostUSD": totals["totalCost"],
            "totalTokens": totals["totalTokens"],
            "missingCostEntries": totals["missingCostEntries"],
            "resetOffsetMinutes": int(reset_offset_minutes or 0),
        },
    }


def compute_direct_claude_minimax_usage(
    *,
    window_minutes: int,
    budget_usd: float,
    reset_offset_minutes: int,
    errors: list[dict[str, Any]],
    max_stderr_chars: int,
) -> dict[str, Any] | None:
    """
    Track MiniMax usage from direct Claude CLI sessions (not through Clawdbot).
    Scans ~/.claude/ directory for JSONL files with MiniMax model usage.
    """
    window_minutes = int(window_minutes or 0)
    if window_minutes <= 0:
        window_minutes = 300

    budget = float(budget_usd or 0.0)
    if budget < 0 or budget != budget:
        budget = 0.0

    now_utc = datetime.now(timezone.utc)
    now_ts = now_utc.timestamp()
    window_s = float(window_minutes) * 60.0
    offset_s = float(int(reset_offset_minutes or 0) * 60)
    window_index = int((now_ts - offset_s) // window_s)
    window_start_s = window_index * window_s + offset_s
    window_end_s = window_start_s + window_s

    window_end_dt = datetime.fromtimestamp(window_end_s, tz=timezone.utc)
    resets_at = window_end_dt.strftime("%Y-%m-%dT%H:%M:%SZ")

    totals: dict[str, float] = {
        "totalTokens": 0.0,
        "totalCost": 0.0,
        "missingCostEntries": 0.0,
    }

    # Scan ~/.claude/ directory and any custom homeDirs used by Clawdbot
    claude_dirs = [Path.home() / ".claude"]

    # Add custom homeDir used by ClaudeMinimaxBot
    minimax_custom_home = Path("/home/web/.clawdbot-claude-bypass-home-minimax/.claude")
    if minimax_custom_home.is_dir():
        claude_dirs.append(minimax_custom_home)

    # Add web user's claude directory
    web_claude = Path("/home/web/.claude")
    if web_claude.is_dir():
        claude_dirs.append(web_claude)

    # Add droid (factory) sessions directory
    factory_sessions = Path.home() / ".factory"

    # Find all JSONL files in all claude directories
    jsonl_files = []
    for claude_dir in claude_dirs:
        if not claude_dir.is_dir():
            continue
        jsonl_files.extend(claude_dir.glob("*.jsonl"))
        jsonl_files.extend(claude_dir.glob("projects/*/*.jsonl"))
        # Also scan subagent directories
        jsonl_files.extend(claude_dir.glob("projects/*/*/subagents/*.jsonl"))

    # Also scan droid/factory sessions (different structure: sessions/*/*.jsonl)
    if factory_sessions.is_dir():
        jsonl_files.extend(factory_sessions.glob("sessions/*/*.jsonl"))

    if not jsonl_files:
        return None

    for path in sorted(jsonl_files):
        try:
            st = path.stat()
        except Exception:
            continue
        if st.st_mtime < window_start_s:
            continue

        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        entry = json.loads(line)
                    except Exception:
                        continue

                    # Check for MiniMax model in different entry formats
                    model = None
                    usage = None
                    timestamp = None

                    # Format 1: Direct message entry
                    if entry.get("type") == "assistant" and isinstance(entry.get("message"), dict):
                        message = entry.get("message", {})
                        model = message.get("model")
                        usage = message.get("usage")
                        timestamp = entry.get("timestamp")
                    # Format 2: Project session entry
                    elif isinstance(entry.get("message"), dict):
                        message = entry.get("message", {})
                        model = message.get("model")
                        usage = message.get("usage")
                        timestamp = entry.get("timestamp")

                    # Check if this is MiniMax
                    if model and "minimax" in str(model).lower():
                        if not isinstance(usage, dict):
                            continue

                        dt_utc = parse_iso_datetime(timestamp)
                        if dt_utc is None:
                            continue
                        ts = dt_utc.timestamp()
                        if ts < window_start_s or ts >= window_end_s:
                            continue

                        # Extract tokens (different format from Clawdbot)
                        input_tokens = as_finite_number(usage.get("input_tokens"))
                        output_tokens = as_finite_number(usage.get("output_tokens"))
                        cache_read = as_finite_number(usage.get("cache_read_input_tokens"))
                        cache_write = as_finite_number(usage.get("cache_creation_input_tokens"))
                        total_tokens = as_finite_number(usage.get("total_tokens"))

                        if total_tokens is None:
                            total_tokens = (input_tokens or 0.0) + (output_tokens or 0.0) + (cache_read or 0.0) + (cache_write or 0.0)

                        # Calculate cost using MiniMax pricing
                        if input_tokens is None and output_tokens is None and cache_read is None and cache_write is None:
                            totals["missingCostEntries"] += 1.0
                            cost_total = 0.0
                        else:
                            cost_total = compute_minimax_cost_usd(
                                input_tokens=input_tokens,
                                output_tokens=output_tokens,
                                cache_read_tokens=cache_read,
                                cache_write_tokens=cache_write,
                            )

                        totals["totalTokens"] += total_tokens
                        totals["totalCost"] += cost_total

        except Exception as e:
            errors.append(
                {
                    "command": "direct claude cli scan",
                    "exitCode": 1,
                    "message": safe_tail(str(e), max_stderr_chars) or "Failed to scan Claude CLI logs",
                }
            )

    # Also scan droid/factory .settings.json files (usage stored separately from sessions)
    if factory_sessions.is_dir():
        try:
            for settings_path in factory_sessions.glob("sessions/*/*.settings.json"):
                try:
                    st = settings_path.stat()
                except Exception:
                    continue
                if st.st_mtime < window_start_s:
                    continue

                try:
                    with open(settings_path, "r", encoding="utf-8", errors="replace") as f:
                        data = json.load(f)
                except Exception:
                    continue

                if not isinstance(data, dict):
                    continue

                model = data.get("model", "")
                if not model or "minimax" not in str(model).lower():
                    continue

                token_usage = data.get("tokenUsage")
                if not isinstance(token_usage, dict):
                    continue

                # Get timestamp from providerLockTimestamp or file mtime
                timestamp = data.get("providerLockTimestamp")
                if timestamp:
                    dt_utc = parse_iso_datetime(timestamp)
                    if dt_utc:
                        ts = dt_utc.timestamp()
                        if ts < window_start_s or ts >= window_end_s:
                            continue

                # Extract tokens (droid format)
                input_tokens = as_finite_number(token_usage.get("inputTokens"))
                output_tokens = as_finite_number(token_usage.get("outputTokens"))
                cache_read = as_finite_number(token_usage.get("cacheReadTokens"))
                cache_write = as_finite_number(token_usage.get("cacheCreationTokens"))

                total_tokens = (input_tokens or 0.0) + (output_tokens or 0.0) + (cache_read or 0.0) + (cache_write or 0.0)

                if input_tokens is None and output_tokens is None and cache_read is None and cache_write is None:
                    totals["missingCostEntries"] += 1.0
                    cost_total = 0.0
                else:
                    cost_total = compute_minimax_cost_usd(
                        input_tokens=input_tokens,
                        output_tokens=output_tokens,
                        cache_read_tokens=cache_read,
                        cache_write_tokens=cache_write,
                    )

                totals["totalTokens"] += total_tokens
                totals["totalCost"] += cost_total

        except Exception as e:
            errors.append(
                {
                    "command": "droid factory scan",
                    "exitCode": 1,
                    "message": safe_tail(str(e), max_stderr_chars) or "Failed to scan droid sessions",
                }
            )

    used_percent = 0.0
    if budget > 0:
        used_percent = (totals["totalCost"] / budget) * 100.0

    login_method = f"Coding subscription (${budget:g})" if budget > 0 else "Coding subscription"

    return {
        "updatedAt": utc_now_iso(),
        "identity": {
            "loginMethod": login_method,
            "providerID": "minimax",
        },
        "primary": {
            "usedPercent": used_percent,
            "resetsAt": resets_at,
            "windowMinutes": window_minutes,
        },
        "secondary": None,
        "tertiary": None,
        "loginMethod": login_method,
        "window": {
            "budgetUSD": budget,
            "totalCostUSD": totals["totalCost"],
            "totalTokens": totals["totalTokens"],
            "missingCostEntries": totals["missingCostEntries"],
            "resetOffsetMinutes": int(reset_offset_minutes or 0),
        },
    }


def merge_cost_items_by_provider(base: list[Any], delta: dict[str, Any], provider: str) -> None:
    if not delta:
        return

    target = None
    for item in base:
        if isinstance(item, dict) and item.get("provider") == provider:
            target = item
            break

    if target is None:
        base.append(delta)
        return

    # Merge totals + 30d totals
    target_totals = target.get("totals")
    if not isinstance(target_totals, dict):
        target_totals = {}
        target["totals"] = target_totals
    delta_totals = delta.get("totals")
    if isinstance(delta_totals, dict):
        for key in ["inputTokens", "outputTokens", "cacheReadTokens", "cacheCreationTokens", "totalTokens", "totalCost"]:
            a = as_finite_number(target_totals.get(key)) or 0.0
            b = as_finite_number(delta_totals.get(key)) or 0.0
            target_totals[key] = a + b

    for key in ["last30DaysTokens", "last30DaysCostUSD"]:
        a = as_finite_number(target.get(key)) or 0.0
        b = as_finite_number(delta.get(key)) or 0.0
        target[key] = a + b

    # Mark combined source to avoid confusion.
    base_source = str(target.get("source") or "").strip() or "local"
    delta_source = str(delta.get("source") or "").strip()
    if delta_source and delta_source not in base_source:
        target["source"] = f"{base_source}+{delta_source}"

    # Merge daily entries by date
    target_daily = target.get("daily")
    if not isinstance(target_daily, list):
        target_daily = []
        target["daily"] = target_daily
    by_date: dict[str, dict[str, Any]] = {}
    for d in target_daily:
        if isinstance(d, dict) and isinstance(d.get("date"), str):
            by_date[d["date"]] = d

    delta_daily = delta.get("daily")
    if isinstance(delta_daily, list):
        for d in delta_daily:
            if not isinstance(d, dict) or not isinstance(d.get("date"), str):
                continue
            date = d["date"]
            existing = by_date.get(date)
            if existing is None:
                target_daily.append(d)
                by_date[date] = d
                continue

            for key in ["inputTokens", "outputTokens", "cacheReadTokens", "cacheCreationTokens", "totalTokens", "totalCost"]:
                a = as_finite_number(existing.get(key)) or 0.0
                b = as_finite_number(d.get(key)) or 0.0
                existing[key] = a + b

            # Merge modelsUsed
            models_used = set(existing.get("modelsUsed") or []) if isinstance(existing.get("modelsUsed"), list) else set()
            models_used.update(d.get("modelsUsed") or [])
            existing["modelsUsed"] = sorted([m for m in models_used if isinstance(m, str) and m])

            # Merge modelBreakdowns
            def to_cost_map(items: Any) -> dict[str, float]:
                out: dict[str, float] = {}
                if not isinstance(items, list):
                    return out
                for mb in items:
                    if not isinstance(mb, dict):
                        continue
                    name = mb.get("modelName")
                    cost = as_finite_number(mb.get("cost")) or 0.0
                    if isinstance(name, str) and name:
                        out[name] = out.get(name, 0.0) + cost
                return out

            merged = to_cost_map(existing.get("modelBreakdowns"))
            for name, cost in to_cost_map(d.get("modelBreakdowns")).items():
                merged[name] = merged.get(name, 0.0) + cost
            existing["modelBreakdowns"] = [
                {"modelName": name, "cost": cost} for name, cost in sorted(merged.items(), key=lambda kv: kv[1], reverse=True)
            ]

    target_daily.sort(key=lambda d: d.get("date") or "")


def fill_missing_cost_days(cost_items: list[Any], *, tz_name: str, days: int) -> None:
    """
    CodexBar cost output omits days with 0 usage, which makes charts/ranges
    look like data is missing (especially near "today"). Fill explicit zero
    entries for the last N days in the target timezone.
    """
    if not isinstance(days, int) or days <= 0:
        return

    try:
        tz = ZoneInfo(tz_name)
    except Exception:
        return

    now_utc = datetime.now(timezone.utc)
    end_date = now_utc.astimezone(tz).date()
    start_date = end_date - timedelta(days=days - 1)
    required_dates = [(start_date + timedelta(days=i)).isoformat() for i in range(days)]
    required_set = set(required_dates)

    for item in cost_items:
        if not isinstance(item, dict):
            continue
        daily = item.get("daily")
        if not isinstance(daily, list):
            continue

        by_date: dict[str, dict[str, Any]] = {}
        extras: list[dict[str, Any]] = []
        for d in daily:
            if not isinstance(d, dict):
                continue
            date = d.get("date")
            if not isinstance(date, str) or not date:
                continue
            if date in required_set:
                # Keep the first entry for each day (should be unique after merges).
                by_date.setdefault(date, d)
            else:
                extras.append(d)

        filled: list[dict[str, Any]] = []
        for date in required_dates:
            existing = by_date.get(date)
            if existing is not None:
                filled.append(existing)
                continue

            filled.append(
                {
                    "date": date,
                    "inputTokens": 0.0,
                    "outputTokens": 0.0,
                    "cacheReadTokens": 0.0,
                    "cacheCreationTokens": 0.0,
                    "totalTokens": 0.0,
                    "totalCost": 0.0,
                    "modelBreakdowns": [],
                    "modelsUsed": [],
                }
            )

        merged_daily = extras + filled
        merged_daily.sort(key=lambda d: str(d.get("date") or ""))
        item["daily"] = merged_daily


def load_kimi_history_for_heatmap(data_dir: Path) -> list[dict[str, Any]]:
    """
    Load Kimi history from kimi-history.json and convert to heatmap format.
    Returns list of entries with {ts, hour, day, provider, account, activity}.
    """
    kimi_history_path = data_dir / "kimi-history.json"
    if not kimi_history_path.is_file():
        return []
    
    try:
        with open(kimi_history_path, "r", encoding="utf-8") as f:
            kimi_data = json.load(f)
    except Exception:
        return []
    
    if not isinstance(kimi_data, list):
        return []
    
    entries = []
    for item in kimi_data:
        if not isinstance(item, dict):
            continue
        
        ts = item.get("ts")
        activity = item.get("activity")
        
        if ts is None or activity is None:
            continue
        
        # Parse timestamp to get hour and day
        dt = parse_iso_datetime(ts)
        if dt is None:
            continue
        
        # Convert to local time for hour/day display
        dt_local = dt.astimezone()
        hour = dt_local.hour
        day = dt_local.strftime("%Y-%m-%d")
        
        entries.append({
            "ts": ts,
            "hour": hour,
            "day": day,
            "provider": "kimi",
            "account": item.get("account", "default"),
            "activity": float(activity) if isinstance(activity, (int, float)) else 0.0,
        })
    
    return entries


def update_hourly_history(
    data_dir: Path,
    usage_items: list[dict[str, Any]],
    generated_at: str,
    current_codex_account: str | None = None,
    provider_history_entries: list[dict[str, Any]] | None = None,
    excluded_providers: set[str] | None = None,
) -> None:
    """
    Track hourly usage history for heatmap visualization.
    Calculates delta (activity) by comparing current values to previous run.
    Each entry: {ts, hour, day, provider, account, activity}
    Keep last 30 days of data.
    """
    history_path = data_dir / "history.json"
    state_path = data_dir / ".history_state.json"

    history = load_history(history_path)
    external_entries = [entry for entry in (provider_history_entries or []) if isinstance(entry, dict)]
    excluded_provider_ids = {
        str(provider).strip().lower()
        for provider in (excluded_providers or set())
        if str(provider).strip()
    }
    if excluded_provider_ids:
        history = [
            entry
            for entry in history
            if str(entry.get("provider") or "").strip().lower() not in excluded_provider_ids
        ]
        external_entries = [
            entry
            for entry in external_entries
            if str(entry.get("provider") or "").strip().lower() not in excluded_provider_ids
        ]

    external_providers = {
        str(entry.get("provider") or "").strip().lower()
        for entry in external_entries
        if str(entry.get("provider") or "").strip()
    }
    external_sources_by_provider: dict[str, set[str]] = {}
    for entry in external_entries:
        provider_id = str(entry.get("provider") or "").strip().lower()
        if not provider_id:
            continue
        source_id = str(entry.get("source") or "").strip().lower()
        external_sources_by_provider.setdefault(provider_id, set()).add(source_id)

    if external_providers:
        history = [
            entry
            for entry in history
            if not (
                str(entry.get("provider") or "").strip().lower() in external_providers
                and str(entry.get("source") or "").strip().lower()
                in external_sources_by_provider.get(str(entry.get("provider") or "").strip().lower(), set())
            )
        ]
    
    # Merge Kimi history from kimi-history.json
    kimi_entries = load_kimi_history_for_heatmap(data_dir)
    if kimi_entries:
        # Create a set of existing (day, hour, provider) combinations to avoid duplicates
        existing_keys = {(e.get("day"), e.get("hour"), e.get("provider")) for e in history}
        for entry in kimi_entries:
            key = (entry.get("day"), entry.get("hour"), entry.get("provider"))
            if key not in existing_keys:
                history.append(entry)
                existing_keys.add(key)
    prev_state = load_json(state_path) if state_path.is_file() else {}
    if not isinstance(prev_state, dict):
        prev_state = {}
    if excluded_provider_ids and isinstance(prev_state, dict):
        prev_state = {
            key: value
            for key, value in prev_state.items()
            if str(key).split("|", 1)[0].strip().lower() not in excluded_provider_ids
        }

    # Use local time for hour/day display
    now_local = datetime.now()
    now = datetime.now(timezone.utc)
    generated_dt = parse_iso_datetime(generated_at) or now
    hour = now_local.hour
    day = now_local.strftime("%Y-%m-%d")

    current_state: dict[str, Any] = {}
    latest_external_ts_by_key: dict[str, datetime] = {}
    for entry in external_entries:
        provider = str(entry.get("provider") or "").strip()
        if not provider:
            continue
        account = str(entry.get("account") or "")
        key = f"{provider}|{account}"
        ts = parse_iso_datetime(entry.get("ts"))
        if ts is None:
            continue
        prev_ts = latest_external_ts_by_key.get(key)
        if prev_ts is None or ts > prev_ts:
            latest_external_ts_by_key[key] = ts

    # Extract usage percentages and calculate deltas
    for item in usage_items:
        if not isinstance(item, dict):
            continue

        provider = item.get("provider", "unknown")
        provider_id = str(provider or "unknown").strip().lower()
        if provider_id in excluded_provider_ids:
            continue
        account = item.get("codexAuthAccount", "")

        usage = item.get("usage", {})
        if not isinstance(usage, dict):
            continue

        primary = usage.get("primary", {})
        session_pct = primary.get("usedPercent") if isinstance(primary, dict) else None
        window_minutes = None
        if isinstance(primary, dict):
            try:
                maybe_window_minutes = int(primary.get("windowMinutes"))
            except Exception:
                maybe_window_minutes = 0
            if maybe_window_minutes > 0:
                window_minutes = maybe_window_minutes

        if session_pct is None:
            continue

        key = f"{provider}|{account}"
        # Always update state for all accounts (needed for accurate delta calculation on switch)
        current_state[key] = {"sessionPct": session_pct, "ts": generated_at}

        # Calculate activity delta
        prev = prev_state.get(key, {})
        prev_pct = prev.get("sessionPct")

        activity = 0.0
        if prev_pct is not None and session_pct is not None:
            # If session reset (current < previous), count current as new activity
            if session_pct < prev_pct - 0.5:  # Allow small tolerance for reset detection
                activity = session_pct
            else:
                activity = session_pct - prev_pct
        elif session_pct is not None and session_pct > 0:
            # First run or no previous data - if there's usage, record it
            activity = session_pct

        if provider_id in external_providers:
            fallback_window_minutes = window_minutes or 300
            latest_external_ts = latest_external_ts_by_key.get(key)
            has_recent_external_history = (
                latest_external_ts is not None
                and latest_external_ts >= generated_dt - timedelta(minutes=fallback_window_minutes)
            )
            if has_recent_external_history:
                continue

        # Only record if there was meaningful activity (> 0.1% to avoid noise)
        if activity > 0.1:
            entry = {
                "ts": generated_at,
                "hour": hour,
                "day": day,
                "provider": provider,
                "account": account,
                "activity": round(activity, 1),
                "source": "usage-snapshot",
                "sessionPct": round(float(session_pct), 3),
            }
            history.append(entry)

    if external_entries:
        history.extend(external_entries)

    # Save current state for next comparison
    atomic_write_json(state_path, current_state)

    # Prune entries older than 30 days
    cutoff = (now - timedelta(days=30)).strftime("%Y-%m-%d")
    history = [e for e in history if e.get("day", "") >= cutoff]
    history = prune_redundant_usage_snapshot_runs(history)

    atomic_write_json(history_path, history)


def parse_accounts_env(value: str) -> list[str]:
    value = value.strip()
    if not value:
        return []
    return [part for part in re.split(r"[,\s]+", value) if part]


def load_blocked_codex_accounts(state_path: Path) -> set[str]:
    state = load_json(state_path)
    if not isinstance(state, dict):
        return set()
    blocked = state.get("blockedAccounts")
    if not isinstance(blocked, dict):
        return set()
    out: set[str] = set()
    for account in blocked.keys():
        if isinstance(account, str) and account.strip():
            out.add(account.strip())
    return out


def remove_key_recursive(obj: Any, key: str) -> None:
    if isinstance(obj, dict):
        if key in obj:
            obj.pop(key, None)
        for v in list(obj.values()):
            remove_key_recursive(v, key)
    elif isinstance(obj, list):
        for v in obj:
            remove_key_recursive(v, key)


def publish_shared_claude_webhost_files(*, errors: list[dict[str, Any]], max_stderr_chars: int) -> None:
    publish_enabled = str(os.environ.get("PUBLISH_SHARED_CLAUDE_WEBHOSTS", "1")).strip().lower()
    if publish_enabled in ("0", "false", "off", "no", "disabled"):
        return

    publish_script = Path(os.environ.get("SHARED_CLAUDE_PUBLISH_SCRIPT", "/root/scripts/publish-shared-ai-webhosts.sh"))
    if not publish_script.is_file():
        return

    try:
        timeout_s = int(os.environ.get("SHARED_CLAUDE_PUBLISH_TIMEOUT_S", "90"))
    except Exception:
        timeout_s = 90

    res = run_cmd([str(publish_script)], timeout_s=timeout_s)
    if res.exit_code != 0:
        errors.append(
            {
                "command": str(publish_script),
                "exitCode": res.exit_code,
                "severity": "warning",
                "message": safe_tail(res.stderr or res.stdout, max_stderr_chars) or f"Exit {res.exit_code}",
            }
        )


def main() -> int:
    os.umask(0o022)

    base_dir = Path(__file__).resolve().parent.parent
    data_dir = base_dir / "public" / "data"
    claude_stats_path = data_dir / "claude-stats.json"
    claude_usage_path = data_dir / "claude-usage.json"

    home_dir = str(Path.home())
    base_env = ensure_path_has_dir(dict(os.environ), str(Path(home_dir) / ".local" / "bin"))
    if not base_env.get("HOME"):
        base_env["HOME"] = home_dir

    codexbar_bin = os.environ.get("CODEXBAR_BIN", "/usr/local/bin/codexbar")
    usage_timeout_s = int(os.environ.get("USAGE_TIMEOUT_S", "60"))
    cost_timeout_s = int(os.environ.get("COST_TIMEOUT_S", "180"))
    max_stderr_chars = int(os.environ.get("MAX_STDERR_CHARS", "4000"))

    # Local Claude activity (read-only) is used to decide whether a costly
    # `claude -p ...` refresh is actually worth doing.
    try:
        claude_activity_max_files = int(os.environ.get("CLAUDE_ACTIVITY_MAX_FILES", "250"))
    except Exception:
        claude_activity_max_files = 250
    try:
        claude_activity_max_bytes = int(os.environ.get("CLAUDE_ACTIVITY_MAX_BYTES", "256000"))
    except Exception:
        claude_activity_max_bytes = 256000
    claude_activity = compute_last_claude_activity(max_files=claude_activity_max_files, max_bytes=claude_activity_max_bytes)

    # Claude refresh gating state (stored locally, no secrets).
    claude_refresh_state_path = data_dir / ".claude-refresh-state.json"
    claude_refresh_state = load_json(claude_refresh_state_path)
    if not isinstance(claude_refresh_state, dict):
        claude_refresh_state = {}
    claude_refresh_policy = str(os.environ.get("CLAUDE_REFRESH_POLICY", "if-new-activity")).strip().lower() or "if-new-activity"
    try:
        claude_refresh_min_interval_s = int(os.environ.get("CLAUDE_REFRESH_MIN_INTERVAL_S", "1800"))
    except Exception:
        claude_refresh_min_interval_s = 1800
    if claude_refresh_min_interval_s < 0:
        claude_refresh_min_interval_s = 0
    claude_refresh_meta: dict[str, Any] = {
        "policy": claude_refresh_policy,
        "minIntervalSec": claude_refresh_min_interval_s,
        "attempted": False,
        "skipped": False,
        "reason": "",
        "lastActivityAt": (claude_activity.get("overall") or {}).get("tsUtc") if isinstance(claude_activity, dict) else None,
        "lastUsageOkAt": claude_refresh_state.get("lastClaudeUsageOkAt"),
        "lastRefreshAttemptAt": claude_refresh_state.get("lastClaudeRefreshAttemptAt"),
    }

    codex_accounts_dir = Path(os.environ.get("CODEX_ACCOUNTS_DIR", str(Path.home() / ".codex" / "accounts")))
    codex_config_toml = Path(os.environ.get("CODEX_CONFIG_TOML", str(Path.home() / ".codex" / "config.toml")))
    selected_accounts = parse_accounts_env(os.environ.get("CODEX_AUTH_ACCOUNTS", ""))
    codex_switcher_state_path = Path(
        os.environ.get(
            "CODEX_AUTH_SWITCHER_STATE_PATH",
            str(Path.home() / ".codex" / "codex-auth-switcher-state.json"),
        )
    )
    blocked_codex_accounts = load_blocked_codex_accounts(codex_switcher_state_path)

    generated_at = utc_now_iso()
    hostname = socket.gethostname()
    shared_claude_now = datetime.now(timezone.utc)
    codex_auth_meta_generated_at = shared_claude_now
    claude_metadata = load_claude_account_metadata()
    claude_responses = collect_shared_claude_responses()
    claude_stats_payload = collect_shared_claude_stats(
        shared_claude_now,
        responses=claude_responses,
        metadata=claude_metadata,
    )
    claude_history_entries = build_shared_claude_history_entries(
        claude_responses,
        now=shared_claude_now,
    )

    # Get current active codex account
    current_codex_account = None
    current_file = Path.home() / ".codex" / "current"
    if current_file.is_file():
        try:
            current_codex_account = current_file.read_text().strip()
        except Exception:
            pass

    errors: list[dict[str, Any]] = []
    usage_items: list[dict[str, Any]] = []
    cost_items: list[Any] = []

    exit_codes: dict[str, Any] = {"usage": {"codex": {}, "claude": None, "antigravity": None, "minimax": None}, "cost": None}

    # Support multiple clawdbot state directories for minimax
    minimax_state_dirs_env = os.environ.get("CLAWDBOT_MINIMAX_STATE_DIRS", "")
    if minimax_state_dirs_env.strip():
        minimax_state_dirs = [Path(p.strip()) for p in minimax_state_dirs_env.split(":") if p.strip()]
    else:
        # Default: scan common minimax clawdbot profiles
        minimax_state_dirs = [
            Path(os.environ.get("CLAWDBOT_MINIMAX_STATE_DIR", str(Path.home() / ".clawdbot-clawdminimaxbot"))),
            Path.home() / ".clawdbot-minimax",
        ]
    try:
        minimax_session_budget_usd = float(os.environ.get("MINIMAX_SESSION_BUDGET_USD", "50"))
    except Exception:
        minimax_session_budget_usd = 50.0
    try:
        minimax_session_window_minutes = int(os.environ.get("MINIMAX_SESSION_WINDOW_MINUTES", "300"))
    except Exception:
        minimax_session_window_minutes = 300
    try:
        minimax_session_reset_offset_minutes = int(os.environ.get("MINIMAX_SESSION_RESET_OFFSET_MINUTES", "0"))
    except Exception:
        minimax_session_reset_offset_minutes = 0

    # --- Codex: multi-account via codex-auth profiles (isolated HOME per profile; no global switching).
    all_account_files = sorted(codex_accounts_dir.glob("*.json")) if codex_accounts_dir.is_dir() else []
    if selected_accounts:
        by_name = {p.stem: p for p in all_account_files}
        account_files: list[Path] = []
        for name in selected_accounts:
            p = by_name.get(name)
            if p is None:
                errors.append(
                    {
                        "command": "codexbar usage --provider codex",
                        "profile": name,
                        "exitCode": 1,
                        "message": f"codex-auth profile not found: {codex_accounts_dir}/{name}.json",
                    }
                )
                continue
            account_files.append(p)
    else:
        account_files = all_account_files

    if blocked_codex_accounts:
        filtered_account_files: list[Path] = []
        for account_file in account_files:
            profile = account_file.stem
            if profile in blocked_codex_accounts:
                errors.append(
                    {
                        "command": "codexbar usage --provider codex",
                        "profile": profile,
                        "exitCode": 0,
                        "severity": "warning",
                        "message": (
                            f"Skipped blocked codex-auth profile '{profile}' from "
                            f"{codex_switcher_state_path}. Waiting for fresh token."
                        ),
                    }
                )
                continue
            filtered_account_files.append(account_file)
        account_files = filtered_account_files

    identity_profiles: dict[str, list[str]] = {}
    codex_auth_meta_by_profile: dict[str, dict[str, Any]] = {}
    for account_file in account_files:
        profile = account_file.stem
        account_payload = load_json(account_file)
        auth_meta = codex_profile_auth_meta(account_payload, now=codex_auth_meta_generated_at)
        if auth_meta:
            codex_auth_meta_by_profile[profile] = auth_meta
        identity_key = codex_profile_identity_key(account_payload)
        if not identity_key:
            continue
        identity_profiles.setdefault(identity_key, []).append(profile)

    for identity_key, profiles in identity_profiles.items():
        unique_profiles = sorted(set(profiles))
        if len(unique_profiles) < 2:
            continue
        errors.append(
            {
                "command": "codex-auth profiles",
                "exitCode": 0,
                "severity": "warning",
                "profiles": unique_profiles,
                "message": (
                    "Multiple codex-auth profiles appear to map to the same OpenAI identity "
                    f"(id:{short_identity_fingerprint(identity_key)}): {', '.join(unique_profiles)}. "
                    "Re-auth one profile with the correct account to avoid duplicated dashboard usage."
                ),
            }
        )

    if not account_files:
        errors.append(
            {
                "command": "codexbar usage --provider codex",
                "exitCode": 1,
                "message": f"No codex-auth accounts found in {codex_accounts_dir}",
            }
        )

    for account_file in account_files:
        profile = account_file.stem
        # Codex/CodexBar may leave plugin files behind briefly in the temp HOME.
        # We already have the command result by this point, so cleanup races
        # should not fail the whole 5-minute stats refresh job.
        with tempfile.TemporaryDirectory(prefix="codex-home-", ignore_cleanup_errors=True) as tmp_home:
            tmp_home_path = Path(tmp_home)
            tmp_codex_dir = tmp_home_path / ".codex"
            tmp_codex_dir.mkdir(parents=True, exist_ok=True)
            (tmp_codex_dir / "auth.json").symlink_to(account_file)
            if codex_config_toml.is_file():
                shutil.copy2(codex_config_toml, tmp_codex_dir / "config.toml")

            env = dict(base_env)
            env["HOME"] = tmp_home

            res = run_cmd(
                [codexbar_bin, "usage", "--provider", "codex", "--format", "json", "--json-only"],
                timeout_s=usage_timeout_s,
                env=env,
            )

        exit_codes["usage"]["codex"][profile] = res.exit_code

        if res.stderr.strip() or res.exit_code != 0:
            errors.append(
                {
                    "command": "codexbar usage --provider codex",
                    "profile": profile,
                    "exitCode": res.exit_code,
                    "message": safe_tail(res.stderr, max_stderr_chars) or f"Exit {res.exit_code}",
                }
            )

        parsed = parse_json_arrays(res.stdout, errors=errors, context=f"usage.codex.{profile}")
        for item in parsed:
            if isinstance(item, dict) and item.get("provider") != "cli":
                item["codexAuthAccount"] = profile
                auth_meta = codex_auth_meta_by_profile.get(profile)
                if auth_meta:
                    item["auth"] = dict(auth_meta)
                usage_items.append(item)

    # --- Claude usage (OAuth, configured in ~/.codexbar/config.json)
    claude_res = run_cmd(
        [codexbar_bin, "usage", "--provider", "claude", "--format", "json", "--json-only"],
        timeout_s=usage_timeout_s,
        env=base_env,
    )
    claude_parsed = parse_json_arrays(claude_res.stdout, errors=errors, context="usage.claude")
    claude_needs_refresh = is_claude_oauth_token_expired(claude_res) or has_claude_fetch_strategy_error(claude_parsed)
    if claude_needs_refresh:
        now_utc = datetime.now(timezone.utc)
        last_activity_ts = None
        if isinstance(claude_activity, dict):
            overall = claude_activity.get("overall")
            if isinstance(overall, dict):
                last_activity_ts = parse_iso_datetime(overall.get("tsUtc"))
        last_ok_ts = parse_iso_datetime(claude_refresh_state.get("lastClaudeUsageOkAt"))
        last_attempt_ts = parse_iso_datetime(claude_refresh_state.get("lastClaudeRefreshAttemptAt"))

        has_new_activity = last_activity_ts is not None and (last_ok_ts is None or last_activity_ts > last_ok_ts)
        recent_attempt = (
            last_attempt_ts is not None and (now_utc - last_attempt_ts).total_seconds() < float(claude_refresh_min_interval_s)
        )

        allow_refresh = False
        reason = ""

        if claude_refresh_policy in ("never", "off", "disabled", "0", "false"):
            allow_refresh = False
            reason = "policy=never"
        elif recent_attempt:
            allow_refresh = False
            reason = f"recent refresh attempt ({claude_refresh_min_interval_s}s cooldown)"
        elif claude_refresh_policy in ("always", "force"):
            allow_refresh = True
            reason = "policy=always"
        elif claude_refresh_policy in ("on-activity", "activity-window"):
            try:
                window_min = int(os.environ.get("CLAUDE_REFRESH_ACTIVITY_WINDOW_MINUTES", "360"))
            except Exception:
                window_min = 360
            if window_min < 0:
                window_min = 0
            if last_activity_ts is None:
                allow_refresh = False
                reason = "no local Claude activity found"
            else:
                age_s = (now_utc - last_activity_ts).total_seconds()
                allow_refresh = age_s <= float(window_min) * 60.0
                reason = f"activity age {int(age_s)}s (window {window_min}m)"
        else:
            # Default: refresh only if there was local Claude activity since last successful Claude usage fetch.
            allow_refresh = bool(has_new_activity)
            if last_activity_ts is None:
                reason = "no local Claude activity found"
            elif has_new_activity:
                reason = "new local Claude activity since last ok usage fetch"
            else:
                reason = "no new local Claude activity since last ok usage fetch"

        if allow_refresh:
            claude_refresh_meta["attempted"] = True
            claude_refresh_meta["reason"] = reason
            claude_refresh_state["lastClaudeRefreshAttemptAt"] = utc_now_iso()
            claude_refresh_state["lastClaudeRefreshAttemptReason"] = reason
            refresh_claude_oauth_token(errors=errors, max_stderr_chars=max_stderr_chars)
            claude_res = run_cmd(
                [codexbar_bin, "usage", "--provider", "claude", "--format", "json", "--json-only"],
                timeout_s=usage_timeout_s,
                env=base_env,
            )
        else:
            claude_refresh_meta["skipped"] = True
            claude_refresh_meta["reason"] = reason
    exit_codes["usage"]["claude"] = claude_res.exit_code
    claude_parsed = parse_json_arrays(claude_res.stdout, errors=errors, context="usage.claude")
    annotate_claude_usage_errors(claude_parsed)
    claude_has_provider_error = any(isinstance(item, dict) and isinstance(item.get("error"), dict) for item in claude_parsed)
    if claude_res.stderr.strip() or (claude_res.exit_code != 0 and not claude_has_provider_error):
        errors.append(
            {
                "command": "codexbar usage --provider claude",
                "exitCode": claude_res.exit_code,
                "message": safe_tail(claude_res.stderr, max_stderr_chars) or f"Exit {claude_res.exit_code}",
            }
        )
    for item in claude_parsed:
        if isinstance(item, dict) and item.get("provider") != "cli":
            usage_items.append(item)

    # Record last known-good Claude usage fetch time (for refresh gating).
    if not claude_has_provider_error and claude_res.exit_code == 0:
        claude_refresh_state["lastClaudeUsageOkAt"] = generated_at
        if claude_refresh_meta.get("attempted") is True:
            claude_refresh_state["lastClaudeRefreshOkAt"] = generated_at

    # --- Antigravity usage (direct API via local Antigravity CLI credentials)
    antigravity_usage, antigravity_exit_code = collect_antigravity_usage(
        generated_at=generated_at,
        base_env=base_env,
        usage_timeout_s=usage_timeout_s,
        errors=errors,
        max_stderr_chars=max_stderr_chars,
    )
    exit_codes["usage"]["antigravity"] = antigravity_exit_code
    usage_items.append(antigravity_usage)

    # --- Kimi usage (from kimi-usage.json generated by collect-kimi-usage.js)
    kimi_usage_path = data_dir / "kimi-usage.json"
    if kimi_usage_path.is_file():
        try:
            with open(kimi_usage_path, "r", encoding="utf-8") as f:
                kimi_usage = json.load(f)
            if isinstance(kimi_usage, dict) and kimi_usage.get("provider") == "kimi":
                usage_items.append(kimi_usage)
                exit_codes["usage"]["kimi"] = 0
        except Exception:
            pass

    # --- MiniMax usage from Clawdbot profiles (scan multiple directories)
    combined_clawdbot_totals = {"totalTokens": 0.0, "totalCost": 0.0, "missingCostEntries": 0.0}
    minimax_usage = None
    for state_dir in minimax_state_dirs:
        if not state_dir.is_dir():
            continue
        result = compute_clawdbot_window_usage(
            provider="minimax",
            state_dir=state_dir,
            window_minutes=minimax_session_window_minutes,
            budget_usd=minimax_session_budget_usd,
            reset_offset_minutes=minimax_session_reset_offset_minutes,
            errors=errors,
            max_stderr_chars=max_stderr_chars,
        )
        if result and isinstance(result.get("window"), dict):
            combined_clawdbot_totals["totalTokens"] += result["window"].get("totalTokens", 0.0)
            combined_clawdbot_totals["totalCost"] += result["window"].get("totalCostUSD", 0.0)
            combined_clawdbot_totals["missingCostEntries"] += result["window"].get("missingCostEntries", 0.0)
            minimax_usage = result  # Keep last result as template

    # Update minimax_usage with combined totals
    if minimax_usage and isinstance(minimax_usage.get("window"), dict):
        minimax_usage["window"]["totalTokens"] = combined_clawdbot_totals["totalTokens"]
        minimax_usage["window"]["totalCostUSD"] = combined_clawdbot_totals["totalCost"]
        minimax_usage["window"]["missingCostEntries"] = combined_clawdbot_totals["missingCostEntries"]
        if minimax_session_budget_usd > 0:
            minimax_usage["primary"]["usedPercent"] = (combined_clawdbot_totals["totalCost"] / minimax_session_budget_usd) * 100.0

    # --- MiniMax usage from direct Claude CLI: `claude --model minimax`
    direct_minimax_usage = compute_direct_claude_minimax_usage(
        window_minutes=minimax_session_window_minutes,
        budget_usd=minimax_session_budget_usd,
        reset_offset_minutes=minimax_session_reset_offset_minutes,
        errors=errors,
        max_stderr_chars=max_stderr_chars,
    )

    # Combine clawdbot-minimax and direct-cli into a single minimax entry
    combined_minimax_tokens = 0.0
    combined_minimax_cost = 0.0
    combined_minimax_missing = 0.0

    if minimax_usage and isinstance(minimax_usage.get("window"), dict):
        combined_minimax_tokens += minimax_usage["window"].get("totalTokens", 0.0)
        combined_minimax_cost += minimax_usage["window"].get("totalCostUSD", 0.0)
        combined_minimax_missing += minimax_usage["window"].get("missingCostEntries", 0.0)

    if direct_minimax_usage and isinstance(direct_minimax_usage.get("window"), dict):
        combined_minimax_tokens += direct_minimax_usage["window"].get("totalTokens", 0.0)
        combined_minimax_cost += direct_minimax_usage["window"].get("totalCostUSD", 0.0)
        combined_minimax_missing += direct_minimax_usage["window"].get("missingCostEntries", 0.0)

    # --- Fetch real MiniMax API limits
    minimax_api_limits = fetch_minimax_api_limits()
    
    if minimax_usage or direct_minimax_usage or minimax_api_limits:
        # Use whichever result we have as a template
        base_usage = minimax_usage or direct_minimax_usage
        
        # Get timestamps from base_usage or use current time
        updated_at = utc_now_iso()
        if base_usage and isinstance(base_usage.get("updatedAt"), str):
            updated_at = base_usage["updatedAt"]
        
        # Use API limits if available, otherwise fall back to cost-based calculation
        if minimax_api_limits:
            # Format reset description
            remaining_formatted = f"{minimax_api_limits['remaining_count']:,}"
            total_formatted = f"{minimax_api_limits['total_count']:,}"
            reset_in_minutes = minimax_api_limits['remains_time_seconds'] // 60
            if reset_in_minutes < 60:
                reset_formatted = f"{reset_in_minutes}m"
            else:
                reset_formatted = f"{reset_in_minutes // 60}h"
            
            reset_description = f"{minimax_api_limits['usage_count']:,} / {total_formatted} used · {remaining_formatted} remaining · resets in {reset_formatted}"
            
            primary_window = {
                "usedPercent": minimax_api_limits["used_percent"],
                "resetsAt": minimax_api_limits["resets_at"],
                "resetDescription": reset_description,
                "windowMinutes": minimax_api_limits["window_minutes"],
                "isStatOnly": False,
                "modelName": minimax_api_limits["model_name"],
                "remainingCount": minimax_api_limits["remaining_count"],
                "totalCount": minimax_api_limits["total_count"],
                "usageCount": minimax_api_limits["usage_count"],
            }
            login_method = f"MiniMax API ({minimax_api_limits['model_name']})"
            identity = {"providerID": "minimax", "loginMethod": login_method}
        else:
            # Fall back to cost-based percentage
            combined_percent = (combined_minimax_cost / minimax_session_budget_usd * 100.0) if minimax_session_budget_usd > 0 else 0.0
            primary_window = {
                "usedPercent": combined_percent,
                "resetsAt": base_usage.get("primary", {}).get("resetsAt") if base_usage else None,
                "windowMinutes": minimax_session_window_minutes,
            }
            login_method = base_usage.get("loginMethod") if base_usage else "MiniMax"
            identity = base_usage.get("identity") if base_usage else {"providerID": "minimax", "loginMethod": login_method}

        usage_items.append({
            "provider": "minimax",
            "source": "combined",
            "usage": {
                "updatedAt": updated_at,
                "identity": identity,
                "loginMethod": login_method,
                "primary": primary_window,
                "secondary": None,
                "tertiary": None,
                "window": {
                    "budgetUSD": minimax_session_budget_usd,
                    "totalCostUSD": combined_minimax_cost,
                    "totalTokens": combined_minimax_tokens,
                    "missingCostEntries": combined_minimax_missing,
                    "resetOffsetMinutes": minimax_session_reset_offset_minutes,
                },
                "limits": minimax_api_limits,
            },
        })
        exit_codes["usage"]["minimax"] = 0

    # Record provider-level JSON errors even if the command exited 0.
    for item in usage_items:
        if not isinstance(item, dict):
            continue
        err = item.get("error")
        if not isinstance(err, dict):
            continue
        errors.append(
            {
                "command": "codexbar usage",
                "provider": item.get("provider"),
                "profile": item.get("codexAuthAccount"),
                "exitCode": err.get("code", 0),
                "message": err.get("message", "Provider error"),
            }
        )

    # Remove any emails before publishing (public endpoint).
    remove_key_recursive(usage_items, "accountEmail")

    # --- Cost (local logs; Codex + Claude only)
    #
    # CodexBar groups daily totals by the process timezone. The dashboards need:
    # - EN: New York day boundaries
    # - RU: Minsk day boundaries
    #
    # We compute both and publish them so the frontend can switch based on language.
    def run_cost_for_lang(lang: str, tz_name: str, *, refresh: bool) -> CmdResult:
        env = dict(base_env)
        env["TZ"] = tz_name
        args = [codexbar_bin, "cost", "--provider", "both", "--format", "json", "--json-only"]
        if refresh:
            args.append("--refresh")
        return run_cmd(args, timeout_s=cost_timeout_s, env=env)

    # Refresh scan results on the first run to avoid stale "Today" totals.
    cost_res_en = run_cost_for_lang("en", "America/New_York", refresh=True)
    cost_res_ru = run_cost_for_lang("ru", "Europe/Minsk", refresh=False)

    exit_codes["cost"] = {"en": cost_res_en.exit_code, "ru": cost_res_ru.exit_code}

    if cost_res_en.stderr.strip() or cost_res_en.exit_code != 0:
        errors.append(
            {
                "command": "codexbar cost --provider both",
                "lang": "en",
                "tz": "America/New_York",
                "exitCode": cost_res_en.exit_code,
                "message": safe_tail(cost_res_en.stderr, max_stderr_chars) or f"Exit {cost_res_en.exit_code}",
            }
        )
    if cost_res_ru.stderr.strip() or cost_res_ru.exit_code != 0:
        errors.append(
            {
                "command": "codexbar cost --provider both",
                "lang": "ru",
                "tz": "Europe/Minsk",
                "exitCode": cost_res_ru.exit_code,
                "message": safe_tail(cost_res_ru.stderr, max_stderr_chars) or f"Exit {cost_res_ru.exit_code}",
            }
        )

    cost_items_en = parse_json_arrays(cost_res_en.stdout, errors=errors, context="cost.en")
    cost_items_ru = parse_json_arrays(cost_res_ru.stdout, errors=errors, context="cost.ru")
    cost_items_en = [c for c in cost_items_en if isinstance(c, dict) and c.get("provider") != "cli"]
    cost_items_ru = [c for c in cost_items_ru if isinstance(c, dict) and c.get("provider") != "cli"]

    # Temporary model alias pricing: CodexBar may omit cost for gpt-5.3-codex.
    # The expected pricing is the same as gpt-5.2.
    apply_codex_model_alias_pricing(cost_items_en, alias_model="gpt-5.3-codex", priced_model="gpt-5.2")
    apply_codex_model_alias_pricing(cost_items_ru, alias_model="gpt-5.3-codex", priced_model="gpt-5.2")

    # --- Clawdbot Claude cost (local session transcripts)
    #
    # Clawdbot uses `claude -p --output-format json ...` and records per-message
    # usage/cost into ~/.clawdbot session transcripts. CodexBar doesn't scan
    # those files, so we merge them into the Claude cost provider.
    claw_cost_en = compute_clawdbot_cost_delta(
        tz_name="America/New_York",
        days=30,
        errors=errors,
        max_stderr_chars=max_stderr_chars,
        provider="claude",
        source="clawdbot",
        match_providers=("anthropic", "claude"),
        match_model_prefixes=("claude-",),
    )
    claw_cost_ru = compute_clawdbot_cost_delta(
        tz_name="Europe/Minsk",
        days=30,
        errors=errors,
        max_stderr_chars=max_stderr_chars,
        provider="claude",
        source="clawdbot",
        match_providers=("anthropic", "claude"),
        match_model_prefixes=("claude-",),
    )
    if claw_cost_en:
        merge_cost_items_by_provider(cost_items_en, claw_cost_en, "claude")
    if claw_cost_ru:
        merge_cost_items_by_provider(cost_items_ru, claw_cost_ru, "claude")

    # --- Clawdbot MiniMax cost (Clawdbot profile: `clawdbot --profile minimax`)
    minimax_cost_en = compute_clawdbot_cost_delta(
        tz_name="America/New_York",
        days=30,
        errors=errors,
        max_stderr_chars=max_stderr_chars,
        provider="minimax",
        source="clawdbot-minimax",
        state_dir=minimax_state_dirs[0] if minimax_state_dirs else Path.home() / ".clawdbot-minimax",
        match_providers=("minimax",),
    )
    minimax_cost_ru = compute_clawdbot_cost_delta(
        tz_name="Europe/Minsk",
        days=30,
        errors=errors,
        max_stderr_chars=max_stderr_chars,
        provider="minimax",
        source="clawdbot-minimax",
        state_dir=minimax_state_dirs[0] if minimax_state_dirs else Path.home() / ".clawdbot-minimax",
        match_providers=("minimax",),
    )
    if minimax_cost_en:
        merge_cost_items_by_provider(cost_items_en, minimax_cost_en, "minimax")
    if minimax_cost_ru:
        merge_cost_items_by_provider(cost_items_ru, minimax_cost_ru, "minimax")

    # --- Direct CLI MiniMax cost (scans ~/.claude/ for direct MiniMax usage)
    #
    # Direct Claude CLI with MiniMax model stores usage in ~/.claude/ JSONL files.
    # We scan these to get cost data for the direct CLI usage.
    def compute_direct_cli_minimax_cost_delta(
        *,
        tz_name: str,
        days: int,
        errors: list[dict[str, Any]],
        max_stderr_chars: int,
    ) -> dict[str, Any] | None:
        """
        Track MiniMax cost from direct Claude CLI sessions.
        Scans ~/.claude/ directory for JSONL files with MiniMax model usage.
        """
        now_utc = datetime.now(timezone.utc)
        since_utc = now_utc - timedelta(days=max(1, days) - 1)
        since_ts_s = since_utc.timestamp()

        daily: dict[str, dict[str, Any]] = {}
        totals: dict[str, float] = {
            "inputTokens": 0.0,
            "outputTokens": 0.0,
            "cacheReadTokens": 0.0,
            "cacheCreationTokens": 0.0,
            "totalTokens": 0.0,
            "totalCost": 0.0,
            "missingCostEntries": 0.0,
        }

        # Scan ~/.claude/ directory and any custom homeDirs used by Clawdbot
        claude_dirs = [Path.home() / ".claude"]

        # Add custom homeDir used by ClaudeMinimaxBot
        minimax_custom_home = Path("/home/web/.clawdbot-claude-bypass-home-minimax/.claude")
        if minimax_custom_home.is_dir():
            claude_dirs.append(minimax_custom_home)

        # Find all JSONL files in all claude directories
        jsonl_files = []
        for claude_dir in claude_dirs:
            if not claude_dir.is_dir():
                continue
            jsonl_files.extend(claude_dir.glob("*.jsonl"))
            jsonl_files.extend(claude_dir.glob("projects/*/*.jsonl"))

        if not jsonl_files:
            return None

        for path in sorted(jsonl_files):
            try:
                st = path.stat()
            except Exception:
                continue
            if st.st_mtime < since_ts_s:
                continue

            try:
                with open(path, "r", encoding="utf-8", errors="replace") as f:
                    for line in f:
                        line = line.strip()
                        if not line:
                            continue
                        try:
                            entry = json.loads(line)
                        except Exception:
                            continue

                        # Check for MiniMax model in different entry formats
                        model = None
                        usage = None
                        timestamp = None

                        # Format 1: Direct message entry
                        if entry.get("type") == "assistant" and isinstance(entry.get("message"), dict):
                            message = entry.get("message", {})
                            model = message.get("model")
                            usage = message.get("usage")
                            timestamp = entry.get("timestamp")
                        # Format 2: Project session entry
                        elif isinstance(entry.get("message"), dict):
                            message = entry.get("message", {})
                            model = message.get("model")
                            usage = message.get("usage")
                            timestamp = entry.get("timestamp")

                        # Check if this is MiniMax
                        if model and "minimax" in str(model).lower():
                            if not isinstance(usage, dict):
                                continue

                            dt_utc = parse_iso_datetime(timestamp)
                            if dt_utc is None or dt_utc.timestamp() < since_ts_s:
                                continue
                            day = to_ymd_in_tz(dt_utc, tz_name)
                            if not day:
                                continue

                            bucket = daily.get(day)
                            if bucket is None:
                                bucket = {
                                    "date": day,
                                    "inputTokens": 0.0,
                                    "outputTokens": 0.0,
                                    "cacheReadTokens": 0.0,
                                    "cacheCreationTokens": 0.0,
                                    "totalTokens": 0.0,
                                    "totalCost": 0.0,
                                    "missingCostEntries": 0.0,
                                    "modelsUsed": set(),
                                    "modelCosts": {},
                                }
                                daily[day] = bucket

                            # Extract tokens (different format from Clawdbot)
                            input_tokens = as_finite_number(usage.get("input_tokens"))
                            output_tokens = as_finite_number(usage.get("output_tokens"))
                            cache_read = as_finite_number(usage.get("cache_read_input_tokens"))
                            cache_write = as_finite_number(usage.get("cache_creation_input_tokens"))
                            total_tokens = as_finite_number(usage.get("total_tokens"))

                            if total_tokens is None:
                                total_tokens = (input_tokens or 0.0) + (output_tokens or 0.0) + (cache_read or 0.0) + (cache_write or 0.0)

                            # Calculate cost
                            if input_tokens is None and output_tokens is None and cache_read is None and cache_write is None:
                                bucket["missingCostEntries"] += 1.0
                                totals["missingCostEntries"] += 1.0
                                cost_total = 0.0
                            else:
                                cost_total = compute_minimax_cost_usd(
                                    input_tokens=input_tokens,
                                    output_tokens=output_tokens,
                                    cache_read_tokens=cache_read,
                                    cache_write_tokens=cache_write,
                                )

                            bucket["inputTokens"] += input_tokens or 0.0
                            bucket["outputTokens"] += output_tokens or 0.0
                            bucket["cacheReadTokens"] += cache_read or 0.0
                            bucket["cacheCreationTokens"] += cache_write or 0.0
                            bucket["totalTokens"] += total_tokens
                            bucket["totalCost"] += cost_total

                            totals["inputTokens"] += input_tokens or 0.0
                            totals["outputTokens"] += output_tokens or 0.0
                            totals["cacheReadTokens"] += cache_read or 0.0
                            totals["cacheCreationTokens"] += cache_write or 0.0
                            totals["totalTokens"] += total_tokens
                            totals["totalCost"] += cost_total

                            if isinstance(model, str) and model:
                                bucket["modelsUsed"].add(model)
                                model_costs = bucket["modelCosts"]
                                prev_cost = model_costs.get(model, 0.0)
                                model_costs[model] = prev_cost + cost_total

            except Exception as e:
                errors.append(
                    {
                        "command": "direct claude cli cost scan",
                        "exitCode": 1,
                        "message": safe_tail(str(e), max_stderr_chars) or "Failed to scan Direct CLI logs",
                    }
                )

        if not daily:
            return None

        daily_items: list[dict[str, Any]] = []
        for day in sorted(daily.keys()):
            b = daily[day]
            model_breakdowns = [
                {"modelName": name, "cost": cost} for name, cost in sorted(b["modelCosts"].items(), key=lambda kv: kv[1], reverse=True)
            ]
            models_used = sorted(b["modelsUsed"])
            daily_items.append(
                {
                    "date": b["date"],
                    "inputTokens": b["inputTokens"],
                    "outputTokens": b["outputTokens"],
                    "cacheReadTokens": b["cacheReadTokens"],
                    "cacheCreationTokens": b["cacheCreationTokens"],
                    "totalTokens": b["totalTokens"],
                    "totalCost": b["totalCost"],
                    "modelBreakdowns": model_breakdowns,
                    "modelsUsed": models_used,
                }
                )

        return {
            "updatedAt": utc_now_iso(),
            "provider": "minimax",
            "source": "direct-cli",
            "totals": {
                "inputTokens": totals["inputTokens"],
                "outputTokens": totals["outputTokens"],
                "cacheReadTokens": totals["cacheReadTokens"],
                "cacheCreationTokens": totals["cacheCreationTokens"],
                "totalTokens": totals["totalTokens"],
                "totalCost": totals["totalCost"],
            },
            "daily": daily_items,
            "last30DaysTokens": totals["totalTokens"],
            "last30DaysCostUSD": totals["totalCost"],
        }

    direct_minimax_cost_en = compute_direct_cli_minimax_cost_delta(
        tz_name="America/New_York",
        days=30,
        errors=errors,
        max_stderr_chars=max_stderr_chars,
    )
    direct_minimax_cost_ru = compute_direct_cli_minimax_cost_delta(
        tz_name="Europe/Minsk",
        days=30,
        errors=errors,
        max_stderr_chars=max_stderr_chars,
    )
    if direct_minimax_cost_en:
        merge_cost_items_by_provider(cost_items_en, direct_minimax_cost_en, "minimax")
    if direct_minimax_cost_ru:
        merge_cost_items_by_provider(cost_items_ru, direct_minimax_cost_ru, "minimax")

    # Ensure the chart range always includes the last 30 calendar days,
    # even if there was no usage on some days.
    fill_missing_cost_days(cost_items_en, tz_name="America/New_York", days=30)
    fill_missing_cost_days(cost_items_ru, tz_name="Europe/Minsk", days=30)

    # Back-compat: keep the original `cost` field in EN (New York).
    cost_items = cost_items_en

    claude_usage_payload = next(
        (item for item in usage_items if isinstance(item, dict) and item.get("provider") == "claude"),
        {
            "provider": "claude",
            "status": "disabled",
            "updatedAt": generated_at,
        },
    )

    atomic_write_json(claude_stats_path, claude_stats_payload)
    atomic_write_json(claude_usage_path, claude_usage_payload)

    unpublished_providers = {"minimax"}

    def is_unpublished_provider_entry(entry: Any) -> bool:
        if isinstance(entry, dict):
            return str(entry.get("provider", "")).strip().lower() in unpublished_providers
        return False

    def entry_mentions_unpublished_provider(entry: Any) -> bool:
        if is_unpublished_provider_entry(entry):
            return True
        text = entry if isinstance(entry, str) else json.dumps(entry, ensure_ascii=False)
        lower = str(text).lower()
        return any(provider in lower for provider in unpublished_providers)

    published_usage_items = [item for item in usage_items if not is_unpublished_provider_entry(item)]
    published_cost_items_en = [item for item in cost_items_en if not is_unpublished_provider_entry(item)]
    published_cost_items_ru = [item for item in cost_items_ru if not is_unpublished_provider_entry(item)]
    published_errors = [item for item in errors if not entry_mentions_unpublished_provider(item)]

    latest = {
        "generatedAt": generated_at,
        "hostname": hostname,
        "currentCodexAccount": current_codex_account,
        "claudeActivity": claude_activity,
        "claudeRefresh": claude_refresh_meta,
        "usage": published_usage_items,
        "cost": published_cost_items_en,
        "costByLang": {
            "en": published_cost_items_en,
            "ru": published_cost_items_ru,
        },
        "errors": published_errors,
    }

    last_run = {
        "generatedAt": generated_at,
        "ok": len(errors) == 0,
        "exitCodes": exit_codes,
        "errors": errors,
    }

    atomic_write_json(data_dir / "latest.json", latest)
    atomic_write_json(data_dir / "last-run.json", last_run)
    atomic_write_json(claude_refresh_state_path, claude_refresh_state)

    # Update hourly history for heatmap for all providers/accounts.
    update_hourly_history(
        data_dir,
        published_usage_items,
        generated_at,
        current_codex_account,
        provider_history_entries=claude_history_entries,
        excluded_providers=unpublished_providers,
    )
    publish_shared_claude_webhost_files(errors=errors, max_stderr_chars=max_stderr_chars)

    return 0 if last_run["ok"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
